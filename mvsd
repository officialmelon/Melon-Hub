--- Starts the combat AI (idempotent).
startAI = function()
    if aiThread then
        return
    end

    -- The bot drives the character itself, so the WASD controls have to go.
    setPlayerControlsEnabled(false)

    aiThread = task.spawn(function()
        while true do
            if not aiEnabled then
                break
            end

            aiTick()
            task.wait(aiThinkInterval)
        end

        cleanupAIDebug()

        activePath = nil
        activeWaypoint = 1
        cachedPathTarget = nil
        lastRepathTime = 0
        aiTarget = nil
        aiThreats = {}

        local humanoid = myHumanoid()
        local root = myRoot()

        if humanoid and root then
            humanoid:MoveTo(root.Position)
        end

        -- Also reached when the toggle is switched off without stopAI().
        setPlayerControlsEnabled(true)

        aiThread = nil
    end)
end

--- Stops the combat AI.
stopAI = function()
    aiEnabled = false

    local humanoid = myHumanoid()
    local root = myRoot()

    if humanoid and root then
        humanoid:MoveTo(root.Position)
    end

    cleanupAIDebug()

    -- Hand movement back to the player.
    setPlayerControlsEnabled(true)

    aiThread = nil

    if aiOwnsAimbot and AimbotEnabled then
        AimbotEnabled = false
        stopAimbot()
        aiOwnsAimbot = false
    end
end

