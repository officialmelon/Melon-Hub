----------------------------------------------------------------
-- Settings registry
----------------------------------------------------------------
-- Iris is stateless between frames, so every option owns a State object.
-- `settings` also doubles as the config file format.
----------------------------------------------------------------

--- Returns (creating on first use) the State for `key`.
-- @param key unique IniFlag-style name
-- @param kind "bool" | "number" | "string" | "color" | "enum"
-- @param initial default value
local function setting(key, kind, initial)
    local entry = settings[key]

    if not entry then
        entry = {
            kind = kind,
            state = Iris.State(initial),
        }

        settings[key] = entry
    end

    return entry.state
end

--- Calls `apply` whenever `state` changes value.
--   The first frame just records the current value.
local function watch(key, state, apply)
    local listener = settingListeners[key]

    if not listener then
        listener = { last = state:get(), apply = apply }
        settingListeners[key] = listener
        return
    end

    local value = state:get()

    if value ~= listener.last then
        listener.last = value
        listener.apply(value)
    end
end

-- Iris takes *positional* widget arguments (ArgNames[1] = "Text", …), so
-- every call below passes an array.  The second table is the state map.

--- Convenience: a boolean setting wired straight into a global.
local function boolSetting(key, label, initial, apply)
    local state = setting(key, "bool", initial)

    Iris.Checkbox({ label }, { isChecked = state })
    watch(key, state, apply)
end

--- SliderNum args: Text, Increment, Min, Max, Format.
local function slider(key, label, initial, minimum, maximum, increment, format, apply)
    local state = setting(key, "number", initial)

    -- Format must already be a table, otherwise Iris tries to mutate the
    -- frozen argument table on the first update.
    Iris.SliderNum(
        { label, increment, minimum, maximum, { format } },
        { number = state }
    )

    watch(key, state, apply)
end

--- Convenience: a float setting wired straight into a global.
local function floatSetting(key, label, initial, minimum, maximum, format, apply)
    slider(key, label, initial, minimum, maximum, (maximum - minimum) / 200, format or "%.2f", apply)
end

--- Convenience: an integer setting wired straight into a global.
local function intSetting(key, label, initial, minimum, maximum, apply)
    slider(key, label, initial, minimum, maximum, 1, "%.0f", apply)
end

--- Convenience: a colour picker wired straight into a global.
local function colorSetting(key, label, initial, apply)
    local state = setting(key, "color", initial)

    Iris.InputColor3({ label }, { color = state })
    watch(key, state, apply)
end

--- Convenience: a dropdown; `items` maps index -> label.
local function comboSetting(key, label, items, initialIndex, apply)
    local state = setting(key, "number", initialIndex)

    Iris.Combo({ label }, { index = state })

    for index, item in ipairs(items) do
        Iris.Selectable({ item, index }, { index = state })
    end

    Iris.End()
    watch(key, state, apply)
end

