--[[
  Iris - Immediate Mode GUI library by SirMallard (MIT).
  Bundled from https://github.com/officialmelon/Iris-exec for executors.

  Patches applied for the Roblox client:
    * debug.profilebegin/profileend removed (Studio only, nil in game)
    * demo window and unused widgets stripped
    * all rsync-style `require(script.X)` calls inlined
]]

local __irisModules = {}
local __irisCache = {}

local function __irisRequire(name)
    local cached = __irisCache[name]
    if cached ~= nil then
        return cached
    end

    local loader = __irisModules[name]
    if not loader then
        error("Iris: missing module '" .. tostring(name) .. "'", 2)
    end

    local value = loader()
    __irisCache[name] = value
    return value
end

