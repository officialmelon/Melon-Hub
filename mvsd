----------------------------------------------------------------
-- combat/predictive
----------------------------------------------------------------
-- Predictive shooting: sample each enemy's velocity, extrapolate where
-- they will be, and pre-fire the shot so the bullet arrives with them.
--
-- The pipeline is:
--   trackPlayerPosition   -> keep a rolling window of samples
--   predictFuturePosition -> extrapolate a position `t` seconds ahead
--   calculateShotConfidence -> score how predictable that enemy is
--   calculatePreFireTiming  -> pick the best lead time
--   executePreFire          -> schedule the shot
----------------------------------------------------------------

local predictiveConnection = nil

local SAMPLE_LIMIT = 10
local SAMPLE_INTERVAL = 0.05
local LEAD_STEP = 0.05
local MAX_LEAD = 1.5

----------------------------------------------------------------
-- Velocity tracking
----------------------------------------------------------------

--- Samples a player's velocity for the predictive model.
trackPlayerPosition = function(player)
    local character = player and player.Character

    if not character or not character:IsDescendantOf(workspace) then
        return
    end

    if isOnSameTeam(player) then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    if not aiStateData[player] then
        aiStateData[player] = {
            positions = {},
            currentVelocity = Vector3.zero,
            avgVelocity = Vector3.zero,
            isMoving = false,
            lastUpdate = tick(),
            lastPosition = root.Position,
        }
    end

    local state = aiStateData[player]
    local now = tick()
    local elapsed = now - state.lastUpdate

    if elapsed < SAMPLE_INTERVAL then
        return
    end

    local position = root.Position
    local velocity = (position - state.lastPosition) / elapsed

    table.insert(state.positions, {
        pos = position,
        time = now,
        velocity = velocity,
    })

    if #state.positions > SAMPLE_LIMIT then
        table.remove(state.positions, 1)
    end

    state.currentVelocity = velocity
    state.lastPosition = position
    state.lastUpdate = now

    if #state.positions >= 3 then
        local total = Vector3.zero

        for index = 1, #state.positions do
            total = total + state.positions[index].velocity
        end

        state.avgVelocity = total / #state.positions
        state.isMoving = state.avgVelocity.Magnitude > minVelocityThreshold
    end
end

--- Extrapolates a player's position `seconds` into the future.
-- @return Vector3|nil
predictFuturePosition = function(player, seconds)
    local state = aiStateData[player]

    if not state or #state.positions < 2 then
        return nil
    end

    local lastPosition = state.lastPosition
    local avgVelocity = state.avgVelocity

    -- With enough samples, model acceleration; otherwise fall back to
    -- constant speed.
    if #state.positions >= 3 then
        local previousVelocity = state.positions[#state.positions - 1].velocity
        local span = state.positions[#state.positions].time - state.positions[#state.positions - 1].time

        if span > 0 then
            local acceleration = (state.currentVelocity - previousVelocity) / span

            return lastPosition
                + state.currentVelocity * seconds
                + 0.5 * acceleration * seconds * seconds
        end
    end

    return lastPosition + avgVelocity * seconds
end

--- Whether `position` is visible from the camera.
checkVisibilityAtPosition = function(position, ignore)
    if not Character or not Character:FindFirstChild("Head") then
        return false
    end

    if not position then
        return false
    end

    local origin = Camera.CFrame.Position

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { Character, ignore }

    return workspace:Raycast(origin, position - origin, rayParams) == nil
end

----------------------------------------------------------------
-- Scoring
----------------------------------------------------------------

--- 0..100 score of how likely a shot at `player` is to land.
calculateShotConfidence = function(player)
    local state = aiStateData[player]

    if not state or #state.positions < 3 then
        return 0
    end

    -- 1. How steady is the target's speed?
    local speeds = {}

    for index = 1, #state.positions do
        table.insert(speeds, state.positions[index].velocity.Magnitude)
    end

    local speedSum = 0
    for _, speed in ipairs(speeds) do
        speedSum = speedSum + speed
    end

    local speedMean = speedSum / #speeds
    local variance = 0

    for _, speed in ipairs(speeds) do
        variance = variance + (speed - speedMean) ^ 2
    end

    variance = variance / #speeds

    local positionScore = math.max(0, 1 - variance / 100)

    -- 2. Is the target moving in a straight line?
    local directions = {}

    for index = 1, #state.positions do
        local velocity = state.positions[index].velocity

        if velocity.Magnitude > 0.1 then
            table.insert(directions, velocity.Unit)
        end
    end

    local straightness = 0

    if #directions >= 2 then
        local dotSum = 0

        for index = 1, #directions - 1 do
            dotSum = dotSum + directions[index]:Dot(directions[index + 1])
        end

        straightness = math.max(0, dotSum / (#directions - 1))
    end

    -- 3. How fresh is the oldest sample?
    local freshness = 0

    if #state.positions > 0 then
        local age = tick() - state.positions[1].time
        freshness = math.min(age / trackingDuration, 1)
    end

    -- 4. How close is the target?
    local distance = 0

    if Character and Character:FindFirstChild("HumanoidRootPart") and player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart")

        if root then
            distance = (root.Position - Character.HumanoidRootPart.Position).Magnitude
        end
    end

    local proximity = 1 - math.min(distance / 100, 1)

    return (positionScore * 0.4 + straightness * 0.3 + freshness * 0.2 + proximity * 0.1) * 100
end

--- Picks a lead time for a shot at `player`.
-- @return number|nil leadBeforeFiring, Vector3|nil aimPosition, number confidence
calculatePreFireTiming = function(player)
    local character = player and player.Character

    if not character or not character:IsDescendantOf(workspace) then
        return nil, nil, 0
    end

    local state = aiStateData[player]

    if not state or not state.isMoving then
        return nil, nil, 0
    end

    local confidence = calculateShotConfidence(player)

    if confidence < minConfidence then
        return nil, nil, confidence
    end

    if isPlayerInView(player) then
        return nil, nil, confidence
    end

    -- The target is behind cover: look for the first lead time where the
    -- predicted position becomes visible.
    local lead = nil
    local predicted = nil

    for seconds = LEAD_STEP, maxPredictionTime, LEAD_STEP do
        local position = predictFuturePosition(player, seconds)

        if position and checkVisibilityAtPosition(position, character) then
            lead = seconds
            predicted = position
            break
        end
    end

    if not lead or not predicted then
        return nil, nil, confidence
    end

    -- Fire a little before the target walks into view so the bullet
    -- travel time is already accounted for.
    local delay = lead - bulletTravelTime

    if delay > 0 and delay < MAX_LEAD then
        return delay, predicted, confidence
    end

    return nil, nil, confidence
end

----------------------------------------------------------------
-- Firing
----------------------------------------------------------------

--- Schedules a shot `delay` seconds from now.
executePreFire = function(player, delay)
    if preFireScheduled[player] then
        return
    end

    preFireScheduled[player] = true

    task.delay(delay, function()
        if not predictiveEnabled then
            preFireScheduled[player] = nil
            return
        end

        local character = player and player.Character

        if not character or not character:IsDescendantOf(workspace) then
            preFireScheduled[player] = nil
            return
        end

        if predictiveAutoEquip then
            local tool = getEquippedWeapon()

            if not (tool and tool:FindFirstChild("Fire", true)) then
                equipTool("Gun")
                task.wait(0.1)
            end
        end

        if isPlayerInView(player) then
            shootGun(player.Character)
        end

        preFireScheduled[player] = nil
    end)
end

----------------------------------------------------------------
-- Debug overlay
----------------------------------------------------------------

--- Removes the predictive debug drawings.
cleanupPredictiveDebug = function()
    for _, drawing in pairs(predictiveDebugDrawings) do
        if drawing and drawing.Remove then
            drawing:Remove()
        end
    end

    predictiveDebugDrawings = {}
end

--- Draws velocity vectors and predicted positions.
updatePredictiveDebug = function()
    cleanupPredictiveDebug()

    if not predictiveDebug then
        return
    end

    for player, state in pairs(aiStateData) do
        local character = player and player.Character

        if character and character:IsDescendantOf(workspace) then
            local root = character:FindFirstChild("HumanoidRootPart")

            if root then
                local position = root.Position
                local screenPoint, onScreen = Camera:WorldToScreenPoint(position)

                if state.isMoving and state.avgVelocity.Magnitude > 0.1 then
                    local ahead = position + state.avgVelocity * 0.5
                    local aheadPoint, aheadOnScreen = Camera:WorldToScreenPoint(ahead)

                    if onScreen and aheadOnScreen then
                        local line = Drawing.new("Line")

                        line.From = Vector2.new(screenPoint.X, screenPoint.Y)
                        line.To = Vector2.new(aheadPoint.X, aheadPoint.Y)
                        line.Color = Color3.fromRGB(0, 255, 0)
                        line.Thickness = 2
                        line.Transparency = 0.5

                        table.insert(predictiveDebugDrawings, line)
                    end
                end

                -- Draw a small ring at every predicted position.
                for seconds = 0.1, maxPredictionTime, 0.2 do
                    local predicted = predictFuturePosition(player, seconds)

                    if predicted then
                        local point, pointOnScreen = Camera:WorldToScreenPoint(predicted)

                        if pointOnScreen then
                            local radius = 4

                            for angle = 0, math.pi * 2, math.pi / 4 do
                                local line = Drawing.new("Line")

                                line.From = Vector2.new(
                                    point.X + math.cos(angle) * radius,
                                    point.Y + math.sin(angle) * radius
                                )
                                line.To = Vector2.new(
                                    point.X + math.cos(angle + math.pi / 4) * radius,
                                    point.Y + math.sin(angle + math.pi / 4) * radius
                                )
                                line.Color = Color3.fromRGB(255, 255, 0)
                                line.Thickness = 1
                                line.Transparency = 0.5

                                table.insert(predictiveDebugDrawings, line)
                            end
                        end
                    end
                end
            end
        end
    end
end

----------------------------------------------------------------
-- Public API
----------------------------------------------------------------

--- Enables predictive shooting (idempotent).
startPredictiveShooting = function()
    if predictiveConnection then
        return
    end

    predictiveConnection = RunService.Heartbeat:Connect(function()
        if not predictiveEnabled or not isInGame() then
            return
        end

        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character

            if player ~= LocalPlayer
                and character
                and character:IsDescendantOf(workspace)
                and not isOnSameTeam(player)
            then
                trackPlayerPosition(player)
            end
        end

        -- Pick the most promising pre-fire among every tracked enemy.
        local bestTarget = nil
        local bestDelay = math.huge
        local bestConfidence = 0

        for player in pairs(aiStateData) do
            local character = player and player.Character

            if character and character:IsDescendantOf(workspace) then
                local delay, _, confidence = calculatePreFireTiming(player)

                if delay and confidence and delay < bestDelay then
                    bestTarget = player
                    bestDelay = delay
                    bestConfidence = confidence
                end
            end
        end

        if bestTarget then
            predictiveStatus = string.format("Target: %s | Delay: %.2fs | Conf: %.0f%%",
                bestTarget.Name, bestDelay, bestConfidence)

            executePreFire(bestTarget, bestDelay)
        else
            predictiveStatus = "Waiting for peek..."
        end

        updatePredictiveDebug()
    end)
end

--- Disables predictive shooting and clears its samples.
stopPredictiveShooting = function()
    if predictiveConnection then
        predictiveConnection:Disconnect()
        predictiveConnection = nil
    end

    aiStateData = {}
    preFireScheduled = {}
    predictiveStatus = "Disabled"

    cleanupPredictiveDebug()
end

