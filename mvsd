----------------------------------------------------------------
-- core/config
----------------------------------------------------------------
-- Config files live in <workspace>/MSVD_Melon/<name>.json and store the
-- value of every registered Iris setting, keyed by its IniFlag.
--
-- Values are written as { kind, value } so a config made by any version
-- of the hub can be read back safely.
----------------------------------------------------------------

local CONFIG_EXTENSION = ".json"

--- Creates the config folder when it is missing.
local function ensureConfigFolder()
    if not isfolder(configFolder) then
        makefolder(configFolder)
    end
end

--- Returns the path of a named config file.
local function configPath(name)
    return configFolder .. "/" .. name .. CONFIG_EXTENSION
end

----------------------------------------------------------------
-- Value codec
----------------------------------------------------------------

local function encodeSetting(entry)
    local value = entry.state:get()

    if entry.kind == "color" then
        return { kind = "color", r = value.R, g = value.G, b = value.B }
    end

    if entry.kind == "enum" then
        return { kind = "enum", value = value and value.Name or "Unknown" }
    end

    return { kind = entry.kind, value = value }
end

local function decodeSetting(entry, stored)
    if type(stored) ~= "table" then
        return
    end

    if entry.kind == "color" and stored.kind == "color" then
        entry.state:set(Color3.new(stored.r or 1, stored.g or 1, stored.b or 1))
        return
    end

    if entry.kind == "enum" and stored.kind == "enum" then
        local ok, enumItem = pcall(function()
            return Enum.KeyCode[stored.value]
        end)

        if ok and enumItem then
            entry.state:set(enumItem)
        end

        return
    end

    if entry.kind == "bool" then
        entry.state:set(stored.value == true)
    elseif entry.kind == "number" then
        local number = tonumber(stored.value)
        if number then
            entry.state:set(number)
        end
    elseif entry.kind == "string" then
        entry.state:set(tostring(stored.value or ""))
    end
end

----------------------------------------------------------------
-- Config listing
----------------------------------------------------------------

--- Lists every config name currently stored on disk.
-- @return string[]
getConfigList = function()
    ensureConfigFolder()

    local names = {}

    for _, filePath in ipairs(listfiles(configFolder)) do
        if filePath:match("%.json$") then
            local name = filePath:match("([^/\\]+)%.json$")
            if name then
                table.insert(names, name)
            end
        end
    end

    return names
end

----------------------------------------------------------------
-- Save / load / delete
----------------------------------------------------------------

--- Writes every registered setting to `<folder>/<name>.json`.
-- @return boolean, string|nil  success, config name
saveConfig = function(name)
    name = name or currentConfig
    ensureConfigFolder()

    local payload = {}

    for key, entry in pairs(settings) do
        payload[key] = encodeSetting(entry)
    end

    local encoded, json = pcall(function()
        return HttpService:JSONEncode(payload)
    end)

    if not encoded or not json then
        return false, nil
    end

    if not pcall(writefile, configPath(name), json) then
        return false, nil
    end

    currentConfig = name
    return true, name
end

--- Reads a saved config back into every registered setting.
-- @return boolean, string|nil  success, config name
loadConfig = function(name)
    name = name or currentConfig

    local path = configPath(name)
    if not isfile(path) then
        return false
    end

    local read, json = pcall(readfile, path)
    if not read or not json then
        return false
    end

    local decoded, payload = pcall(function()
        return HttpService:JSONDecode(json)
    end)

    if not decoded or type(payload) ~= "table" then
        return false
    end

    for key, stored in pairs(payload) do
        local entry = settings[key]
        if entry then
            decodeSetting(entry, stored)
        end
    end

    currentConfig = name
    return true, name
end

--- Deletes a saved config.
-- @return boolean  whether a file was removed
deleteConfig = function(name)
    if not name or name == "" then
        return false
    end

    local path = configPath(name)
    if not isfile(path) then
        return false
    end

    delfile(path)
    return true
end

