----------------------------------------------------------------
-- Player controls
----------------------------------------------------------------
-- `Humanoid:MoveTo` is overwritten every frame by the PlayerModule control
-- module (it calls `Humanoid:Move` with the WASD vector, which is zero when
-- the player is not pressing anything).  Anything that drives the character
-- itself — the AI, the walk-to-pad step of auto queue — has to switch those
-- controls off first, then back on when it is done.
----------------------------------------------------------------

local playerControls = nil
local controlsDisabled = false
local playerControlsAvailable = false

--- Lazily resolves the game's ControlModule.
local function getPlayerControls()
    if playerControls ~= nil then
        return playerControls or nil
    end

    playerControls = false

    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")

    if playerModule then
        local loaded, module = pcall(require, playerModule)

        if loaded and module then
            local ok, controls = pcall(function()
                return module:GetControls()
            end)

            if ok and controls then
                playerControls = controls
                playerControlsAvailable = true
            end
        end
    end

    return playerControls or nil
end

--- Turns the WASD controls on or off.  Safe to call repeatedly.
local function setPlayerControlsEnabled(enabled)
    local controls = getPlayerControls()
    if not controls then
        return
    end

    if enabled and controlsDisabled then
        controlsDisabled = false
        pcall(function()
            controls:Enable()
        end)
    elseif not enabled and not controlsDisabled then
        controlsDisabled = true
        pcall(function()
            controls:Disable()
        end)
    end
end

--- Walks the local humanoid towards `position`.
--
-- `Humanoid:MoveTo` is the target-based API, which is what path following
-- wants.  When the player controls could not be disabled (some executors
-- block `require` of PlayerModule) it also pushes a raw `Move`, which is the
-- same call the control module uses and therefore wins on the same frame.
local function driveHumanoidTo(position)
    local humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local root = Character and Character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or not position then
        return
    end

    humanoid:MoveTo(position)

    if not playerControlsAvailable then
        local delta = position - root.Position

        if delta.Magnitude > 0.5 then
            humanoid:Move(delta.Unit, false)
        end
    end
end

