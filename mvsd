----------------------------------------------------------------
-- combat/kill_all
----------------------------------------------------------------
-- Two variants of the same idea: fire or stab every enemy once, then
-- wait for the cooldown and do it again.
--
--   KillAllEnabled      one pass per keypress burst
--   LoopKillAllEnabled  endless passes
----------------------------------------------------------------

local killAllThread = nil
local lastKillAllTime = 0

local loopKillAllThread = nil
local lastLoopKillAllTime = 0

----------------------------------------------------------------
-- One-shot kill all
----------------------------------------------------------------

--- Starts the kill-all pass (idempotent).
startKillAll = function()
    if killAllThread then
        return
    end

    killAllThread = RunService.Heartbeat:Connect(function()
        if not KillAllEnabled then
            return
        end

        local now = tick()
        if now - lastKillAllTime < killAllCooldown then
            return
        end

        local players = getAllPlayers()

        for _, player in ipairs(players) do
            local character = player.Character

            if player and character and character:IsDescendantOf(workspace) then
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.Health > 0 then
                    local tool = getEquippedWeapon()
                    local fireSound = tool and tool:FindFirstChild("Fire", true)
                    local throwSound = tool and tool:FindFirstChild("ThrowSound", true)

                    if fireSound then
                        shootGun(character)
                    elseif throwSound then
                        stabKnife(character)
                    elseif equipTool("Gun") or equipTool("Knife") then
                        task.wait(0.1)
                    end

                    lastKillAllTime = now
                    break
                end
            end
        end
    end)
end

--- Stops the kill-all pass.
stopKillAll = function()
    if not killAllThread then
        return
    end

    killAllThread:Disconnect()
    killAllThread = nil
end

----------------------------------------------------------------
-- Looping kill all
----------------------------------------------------------------

--- Starts the endless kill-all pass (idempotent).
startLoopKillAll = function()
    if loopKillAllThread then
        return
    end

    loopKillAllThread = RunService.Heartbeat:Connect(function()
        if not LoopKillAllEnabled then
            return
        end

        local now = tick()
        if now - lastLoopKillAllTime < 0.01 then
            return
        end

        local players = getAllPlayers()

        for _, player in ipairs(players) do
            local character = player.Character

            if player and character and character:IsDescendantOf(workspace) then
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.Health > 0 then
                    local tool = getEquippedWeapon()
                    local fireSound = tool and tool:FindFirstChild("Fire", true)
                    local throwSound = tool and tool:FindFirstChild("ThrowSound", true)

                    if fireSound then
                        shootGun(character)
                    elseif throwSound then
                        stabKnife(character)
                    elseif equipTool("Gun") or equipTool("Knife") then
                        task.wait(0.05)
                    end

                    lastLoopKillAllTime = now
                    break
                end
            end
        end
    end)
end

--- Stops the endless kill-all pass.
stopLoopKillAll = function()
    if not loopKillAllThread then
        return
    end

    loopKillAllThread:Disconnect()
    loopKillAllThread = nil
end

----------------------------------------------------------------
-- automation/auto_farm
----------------------------------------------------------------
-- Queue automation for the GlobalMatchmaking system.
--
-- The flow is:
--   1. check that the local player is allowed to queue,
--   2. find the emptiest ring of the requested size,
--   3. walk to its trigger if needed,
--   4. fire OnQueueJoinRequest and call JoinQueue,
--   5. retry on failure (or on a party change) until the toggle is off.
----------------------------------------------------------------

local GamemodeInfo = require(ReplicatedStorage.GlobalMatchmaking.Modules.GamemodeInfo)
local GamemodeEnum = require(ReplicatedStorage.GlobalMatchmaking.Modules.GamemodeEnum)
local MatchmakingUtil = require(ReplicatedStorage.GlobalMatchmaking.Modules.Util)
local Promise = require(ReplicatedStorage.Modules.Util.Promise)

local JoinQueue = ReplicatedStorage.GlobalMatchmaking.Remotes.JoinQueue
local OnQueueJoinRequest = ReplicatedStorage.GlobalMatchmaking.Bindables.OnQueueJoinRequest
local OnQueueJoinError = ReplicatedStorage.GlobalMatchmaking.Bindables.OnQueueJoinError

local GetMembers = ReplicatedStorage.Party.Bindables.GetMembers
local GetLeaderStatus = ReplicatedStorage.Party.Bindables.GetLeaderStatus
local OnChanged = ReplicatedStorage.Party.Bindables.OnChanged

local joinPromise = nil
local autoFarmThread = nil
local queueChangedConnection = nil

local retryCount = 0
local maxRetries = 5

----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------

--- Maps the UI ring name to the game's gamemode enum.
local function ringTypeToEnum(ringType)
    if ringType == "2v2" then
        return GamemodeEnum.Duo
    elseif ringType == "3v3" then
        return GamemodeEnum.Trio
    elseif ringType == "4v4" then
        return GamemodeEnum.Squad
    end

    return GamemodeEnum.Solo
end

--- Reports a queue failure and either schedules a retry or gives up.
local function handleQueueError(errorMessage)
    OnQueueJoinError:Fire()

    QueueStatus = "Error: " .. tostring(errorMessage)
    retryCount = retryCount + 1

    if AutoFarmEnabled and retryCount < maxRetries then
        task.wait(queueRetryDelay)
        QueueStatus = "Retrying... (" .. retryCount .. "/" .. maxRetries .. ")"
        return
    end

    QueueStatus = "Failed"
    AutoFarmEnabled = false
end

----------------------------------------------------------------
-- Ring discovery
----------------------------------------------------------------
-- The duel rings have been renamed and moved several times by game
-- updates ("workspace.Rings.1v1" became
-- "workspace.Lobby.DuelRingsGroup.DuelRing_1v1", …), so nothing here
-- hard-codes a path.  Instead the ring is *described*:
--
--   * a folder whose name mentions the gamemode      ("DuelRing_1v1")
--   * containing one or more "pad" models            ("DuelPad")
--   * each with an occupancy attribute or a part     ("CharacterCount")
--   * and a walkable trigger part                    ("Pad")
--
-- Anything matching that description is used, wherever it lives.
----------------------------------------------------------------

-- How many players fit on one pad of each gamemode.
local RING_TEAM_SIZE = {
    ["1v1"] = 1,
    ["2v2"] = 2,
    ["3v3"] = 3,
    ["4v4"] = 4,
}

local MAX_SEARCH_DEPTH = 7

--- Whether `name` looks like it belongs to the `ringType` gamemode.
local function nameMatchesRing(name, ringType)
    return name:lower():find(ringType:lower(), 1, true) ~= nil
end

--- The part a player has to stand on to join a pad.
local function padTrigger(pad)
    return pad:FindFirstChild("Pad")
        or pad:FindFirstChild("TriggerPart")
        or pad:FindFirstChild("Trigger")
        or pad:FindFirstChildWhichIsA("BasePart")
end

--- Whether `model` looks like a duel pad.
local function isPad(model)
    if not model:IsA("Model") then
        return false
    end

    if model:GetAttribute("CharacterCount") ~= nil then
        return true
    end

    if model:FindFirstChild("CharacterCount") then
        return true
    end

    return model.Name:lower():find("pad", 1, true) ~= nil and padTrigger(model) ~= nil
end

--- How many players are currently on `pad`.
local function padOccupancy(pad)
    local attribute = pad:GetAttribute("CharacterCount")

    if type(attribute) == "number" then
        return attribute
    end

    -- The attribute is gone: count the characters standing on the pad.
    local count = 0

    for _, child in ipairs(pad:GetChildren()) do
        if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
            count = count + 1
        end
    end

    return count
end

--- Collects the pads nested inside `container`.
local function collectPads(container, pads, depth)
    if depth > 4 then
        return
    end

    for _, child in ipairs(container:GetChildren()) do
        if isPad(child) then
            table.insert(pads, child)
        else
            collectPads(child, pads, depth + 1)
        end
    end
end

--- Every ring folder for `ringType` that contains at least one pad.
local function collectRings(ringType)
    local rings = {}

    local function visit(instance, depth)
        if depth > MAX_SEARCH_DEPTH then
            return
        end

        for _, child in ipairs(instance:GetChildren()) do
            if child:IsA("Folder") and nameMatchesRing(child.Name, ringType) then
                local pads = {}
                collectPads(child, pads, 0)

                if #pads > 0 then
                    table.insert(rings, { folder = child, pads = pads })
                end
            end

            visit(child, depth + 1)
        end
    end

    visit(workspace, 0)
    return rings
end

--- Finds the emptiest pad of `ringType`.
-- @return Model|nil pad, number occupancy
local function findBestRing(ringType)
    local teamSize = RING_TEAM_SIZE[ringType] or 1
    local bestPad = nil
    local bestOccupancy = math.huge

    for _, ring in ipairs(collectRings(ringType)) do
        for _, pad in ipairs(ring.pads) do
            local occupancy = padOccupancy(pad)

            -- Skip pads that already hold a full team.
            if occupancy < teamSize and occupancy < bestOccupancy then
                bestPad = pad
                bestOccupancy = occupancy
            end
        end
    end

    return bestPad, bestOccupancy
end

--- Builds a walkable path between two points.
-- @return table|nil  waypoint list (position + action), or nil
local function computePath(from, to)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = false,
        WaypointSpacing = 4,
    })

    local ok = pcall(function()
        path:ComputeAsync(from, to)
    end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        return nil
    end

    return path:GetWaypoints()
end

--- Walks the local character to `destination`, around walls.
--
-- Straight `MoveTo` walks into the first wall it meets, so this asks
-- PathfindingService for a route (it goes through the entrance) and follows
-- the waypoints, jumping where the path says to.  It re-paths when stuck and
-- falls back to a straight line only when no path exists at all.
-- @return boolean  whether the character got close enough
local function walkTo(destination, timeout, stopDistance)
    local root = Character and Character:FindFirstChild("HumanoidRootPart")
    local humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    -- Pads only register when you are actually on them, so the final
    -- approach has to land in the middle, not at the rim.
    local stop = stopDistance or 2

    if not root or not humanoid then
        return false
    end

    -- Horizontal distance: the pad sits on the floor, and a pathing
    -- fallback may aim a few studs above it.
    local function flatDistance(from)
        local delta = destination - from
        return Vector3.new(delta.X, 0, delta.Z).Magnitude
    end

    if flatDistance(root.Position) <= stop then
        return true
    end

    setPlayerControlsEnabled(false)

    local deadline = os.clock() + (timeout or 20)
    local waypoints = nil
    local index = 2
    local repaths = 0
    local lastCheck = os.clock()
    local lastPosition = root.Position
    local arrived = false

    while os.clock() < deadline do
        root = Character and Character:FindFirstChild("HumanoidRootPart")

        if not root then
            break
        end

        if flatDistance(root.Position) <= stop then
            arrived = true
            break
        end

        -- Stuck (or at the end of the path): recompute a couple of times.
        local now = os.clock()
        local moved = (root.Position - lastPosition).Magnitude

        if now - lastCheck > 2 then
            if moved < 2 or not waypoints or index > #waypoints then
                if repaths < 3 then
                    repaths = repaths + 1
                    waypoints = computePath(root.Position, destination)
                    index = 2
                end
            end

            lastCheck = now
            lastPosition = root.Position
        end

        if not waypoints then
            waypoints = computePath(root.Position, destination)
            index = 2
        end

        if waypoints and index <= #waypoints then
            local waypoint = waypoints[index]

            if (root.Position - waypoint.Position).Magnitude < 4 then
                index = index + 1
            else
                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                end

                driveHumanoidTo(waypoint.Position)
            end
        else
            -- No usable path: walk at it and hop over anything in the way.
            driveHumanoidTo(destination)

            if humanoid.FloorMaterial ~= Enum.Material.Air and now - lastCheck > 0.4 and moved < 2 then
                humanoid.Jump = true
            end
        end

        task.wait(0.1)
    end

    setPlayerControlsEnabled(true)

    return arrived
end

--- Walks the local character onto `pad`'s trigger.
local function walkToRing(pad)
    local trigger = padTrigger(pad)

    if not trigger or not Character then
        return false
    end

    local root = Character:FindFirstChild("HumanoidRootPart")
    if not root then
        return false
    end

    local delta = trigger.Position - root.Position
    if Vector3.new(delta.X, 0, delta.Z).Magnitude <= 1.5 then
        return true
    end

    QueueStatus = "Walking to Ring..."

    -- The pad centre can sit slightly above the navmesh; try both.
    if walkTo(trigger.Position, 20, 2) then
        return true
    end

    if walkTo(trigger.Position + Vector3.new(0, 3, 0), 10, 2) then
        return true
    end

    -- Last resort: creep onto the exact centre.
    return walkTo(trigger.Position, 6, 1.2)
end

--- Shows the "joining queue" notice.
local function showQueuePopup()
    showNotice("Auto Queue", "Joining " .. DesiredRingType .. " queue...", 5)
end

----------------------------------------------------------------
-- Queueing
----------------------------------------------------------------

--- Walks to the emptiest pad of the selected gamemode.  This is what
-- actually queues you: the game watches the pads, not the remote.
local function goToRing(ringType)
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        QueueStatus = "No Character"
        return false
    end

    local pad = findBestRing(ringType)

    if not pad then
        QueueStatus = "No Free Ring"
        return false
    end

    if not walkToRing(pad) then
        QueueStatus = "Could not walk to ring"
        LastQueueAttemptTime = tick()
        return false
    end

    -- Give the pad a moment to register us.
    task.wait(0.8)

    QueueStatus = "At Ring"
    return true
end

--- Public hook for the "Walk to Ring" button.
walkToRingNow = function()
    if goToRing(DesiredRingType) then
        LastQueueAttemptTime = tick()
    end
end

local function tryJoinQueue()
    if not AutoFarmEnabled then
        QueueStatus = "Disabled"
        return
    end

    local now = tick()

    if now - LastQueueAttemptTime < 5 then
        return
    end

    -- 1. Always walk to the pad first.  The pad is the real queue: the
    --    remote below is just a shortcut and has a wins gate
    --    (`Wins >= 50` in a live place) that most players fail.
    if not goToRing(DesiredRingType) then
        return
    end

    LastQueueAttemptTime = now

    -- 2. Try the matchmaking remote as well.
    local gamemode = ringTypeToEnum(DesiredRingType)
    local gamemodeSettings = GamemodeInfo[gamemode]

    if not gamemodeSettings then
        QueueStatus = "At Ring (invalid gamemode)"
        return
    end

    if joinPromise then
        return
    end

    local isPartyLeader = GetLeaderStatus:Invoke()
    local memberCount = #GetMembers:Invoke()
    local canQueue = MatchmakingUtil.CheckIfPlayerCanQueue(LocalPlayer)

    if not isPartyLeader then
        QueueStatus = "At Ring (not leader)"
        return
    end

    if gamemodeSettings.TeamSize < memberCount then
        QueueStatus = "At Ring (party too large)"
        return
    end

    if not canQueue then
        QueueStatus = "At Ring (wins gate)"
        return
    end

    QueueStatus = "Joining Queue..."
    showQueuePopup()
    OnQueueJoinRequest:Fire(gamemode)

    joinPromise = Promise.new(function(resolve, reject)
        if JoinQueue:InvokeServer(gamemode) then
            QueueStatus = "In Queue"
            retryCount = 0
            resolve()
            return
        end

        reject("Queue join failed")
    end):finally(function()
        joinPromise = nil
    end):catch(handleQueueError)

    -- Watchdog: if InvokeServer never returns, do not wedge auto queue.
    local pending = joinPromise

    task.delay(20, function()
        if joinPromise == pending then
            joinPromise = nil
        end
    end)
end

----------------------------------------------------------------
-- Public API
----------------------------------------------------------------

--- Joins the configured queue automatically (idempotent).
startAutoFarm = function()
    if autoFarmThread then
        return
    end

    retryCount = 0
    QueueStatus = "Starting..."

    -- One loop owns queueing: it walks + queues, then waits and tries again.
    -- Previously a failed attempt (walk blocked, ring full, …) just idled
    -- until the party state changed, which looked like "it gave up".
    autoFarmThread = task.spawn(function()
        task.wait(2)

        while AutoFarmEnabled do
            local ok, err = pcall(tryJoinQueue)

            if not ok then
                QueueStatus = "Error: " .. tostring(err)
            end

            task.wait(queueRetryDelay)
        end

        autoFarmThread = nil
    end)

    if not queueChangedConnection then
        queueChangedConnection = OnChanged.Event:Connect(function()
            if not AutoFarmEnabled then
                return
            end

            task.wait(0.5)
            tryJoinQueue()
        end)
    end
end

--- Stops queue automation.
stopAutoFarm = function()
    AutoFarmEnabled = false
    QueueStatus = "Stopped"

    if joinPromise then
        joinPromise:cancel()
        joinPromise = nil
    end

    autoFarmThread = nil

    if queueChangedConnection then
        queueChangedConnection:Disconnect()
        queueChangedConnection = nil
    end
end

----------------------------------------------------------------
-- combat/auto_fire
----------------------------------------------------------------
-- Heartbeat loop that shoots (or throws) at the first visible enemy.
-- Runs on a cooldown so it never spams faster than the gun allows.
----------------------------------------------------------------

local autoFireConnection = nil
local lastAutoFireShot = 0

--- Tries to shoot or throw at `player`.
-- @return boolean  whether an attack was made
local function attack(player)
    local character = player.Character

    if player == LocalPlayer
        or not character
        or not character:IsDescendantOf(workspace)
        or isOnSameTeam(player)
    then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 or not isPlayerInView(player) then
        return false
    end

    if AutoFireMode == "Auto Shoot" then
        local tool = getEquippedWeapon()

        if not (tool and tool:FindFirstChild("Fire", true)) then
            equipTool("Gun")
            task.wait(0.1)
        end

        -- `randomize` adds spread, i.e. makes the shot miss on purpose.
        local randomize = math.random(1, 100) > hitChance
        shootGun(character, randomize)

        return true
    end

    if AutoFireMode == "Auto Throw" then
        local tool = getEquippedWeapon()

        if not (tool and tool:FindFirstChild("ThrowSound", true)) then
            equipTool("Knife")
            task.wait(0.1)
        end

        tool = getEquippedWeapon()

        if not (tool and tool:FindFirstChild("ThrowSound", true)) then
            return false
        end

        return throwKnifeAt(player)
    end

    return false
end

