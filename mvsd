--- Waits up to `timeout` seconds for the local character.
-- `CharacterAdded:Wait()` alone can block the executor thread forever when
-- the character is mid-respawn, which looks like the client hanging.
local function waitForCharacter(timeout)
    local character = LocalPlayer.Character
    if character then
        return character
    end

    local deadline = os.clock() + timeout

    while os.clock() < deadline do
        character = LocalPlayer.Character
        if character then
            return character
        end

        task.wait(0.05)
    end

    return nil
end

