    if triggerbotConnection then
        return
    end

    triggerbotConnection = RunService.Heartbeat:Connect(function()
        if not TriggerBotEnabled then
            return
        end

        local now = tick()
        if now - lastTrigger < TRIGGER_INTERVAL then
            return
        end

        local target = getClosestPlayerToMouse()
        local character = target and target.Character

        if not character
            or target == LocalPlayer
            or not character:IsDescendantOf(workspace)
            or isOnSameTeam(target)
        then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            return
        end

        local tool = getEquippedWeapon()
        local fireSound = tool and tool:FindFirstChild("Fire", true)
        local throwSound = tool and tool:FindFirstChild("ThrowSound", true)

        if fireSound then
            shootGun(character)
            lastTrigger = now
            return
        end

        if not throwSound then
            return
        end

        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        local myRoot = Character:FindFirstChild("HumanoidRootPart")

        if not targetRoot or not myRoot then
            return
        end

        if (targetRoot.Position - myRoot.Position).Magnitude < knifeTriggerRange then
            stabKnife(character)
            lastTrigger = now
        end
    end)
end

