----------------------------------------------------------------
-- automation/ai
----------------------------------------------------------------
-- Combat AI.
--
-- Every think tick the bot:
--   1. builds a threat picture of every enemy in range,
--   2. scores the candidates (distance, exposure, health, height
--      difference, whether a teammate is already fighting them),
--   3. picks a state (APPROACH / ENGAGE / STRAFE / PEEK /
--      REPOSITION / RETREAT),
--   4. moves accordingly — pathfinding when it has to cover ground,
--      strafing when it is in a duel, backing off when it is low HP,
--   5. turns the body towards the target and fires with leading.
--
-- All of the helper names (`calculateExposure`, `getOptimalTarget`,
-- `advancedPathfind`, …) are kept from the original release so the rest
-- of the hub and any external script can still call them.
----------------------------------------------------------------

-- Movement tuning
local REPATH_DISTANCE = 4
local REPATH_TIMEOUT = 4
local STUCK_WINDOW = 2
local STUCK_DISTANCE = 2
local JUMP_COOLDOWN = 0.35
local MIN_FIRE_GAP = 0.05
local MAX_EVALUATED_TARGETS = 5
local THREAT_LIMIT = 6
local COVER_SIZE = 10

-- Height difference at which the bot stops trying to shoot up/down and
-- starts repositioning instead.
local HEIGHT_TOLERANCE = 20
local HIGH_GROUND_PENALTY = 12
local LOW_GROUND_BONUS = 12

----------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------

local function characterOf(player)
    local character = player and player.Character

    if not character or not character:IsDescendantOf(workspace) then
        return nil
    end

    return character
end

local function rootOf(player)
    local character = characterOf(player)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function humanoidOf(player)
    local character = characterOf(player)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function myRoot()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function myHumanoid()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function flatDirection(from, to)
    local offset = Vector3.new(to.X - from.X, 0, to.Z - from.Z)

    if offset.Magnitude <= 0.001 then
        return Vector3.zero
    end

    return offset.Unit
end

--- Right-hand perpendicular of the horizontal direction between two roots.
local function perpendicularDirection(from, to)
    local direction = flatDirection(from, to)

    if direction == Vector3.zero then
        return Vector3.new(0, 0, 1)
    end

    return direction:Cross(Vector3.new(0, 1, 0))
end

--- Whether the local player is holding a weapon at all.
local function hasWeapon()
    local function scan(container)
        if not container then
            return false
        end

        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool")
                and (child:FindFirstChild("Fire", true) or child:FindFirstChild("ThrowSound", true))
            then
                return true
            end
        end

        return false
    end

    return scan(Backpack) or scan(Character)
end

----------------------------------------------------------------
-- Exposure / cover
----------------------------------------------------------------

--- How much of `player`'s body is visible from the local head (0..1).
calculateExposure = function(player)
    local character = characterOf(player)
    if not character then
        return 0
    end

    if not Character or not Character:FindFirstChild("Head") then
        return 0
    end

    local theirHead = character:FindFirstChild("Head")
    if not theirHead then
        return 0
    end

    local myHead = Character.Head

    local bodyParts = {
        theirHead,
        character:FindFirstChild("UpperTorso"),
        character:FindFirstChild("LowerTorso"),
        character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChild("Left Arm"),
        character:FindFirstChild("Right Arm"),
        character:FindFirstChild("Left Leg"),
        character:FindFirstChild("Right Leg"),
        character:FindFirstChild("Torso"),
    }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { Character, character }

    local checked = 0
    local visible = 0

    for _, part in ipairs(bodyParts) do
        if part then
            checked = checked + 1

            if not workspace:Raycast(myHead.Position, part.Position - myHead.Position, rayParams) then
                visible = visible + 1
            end
        end
    end

    if checked == 0 then
        return 0
    end

    return visible / checked
end

--- Finds cover between `origin` and `destination`.
-- @return Vector3|nil coverPosition, number safetyScore (0..1)
findNearestCover = function(origin, destination)
    local now = tick()

    -- The result is cached for two seconds; cover rarely changes.
    if now - coverCacheTime < 2 then
        return coverCache.coverPosition, coverCache.safetyScore
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { Character }

    local rayResult = workspace:Raycast(origin, destination - origin, rayParams)

    if not rayResult then
        coverCache = { coverPosition = nil, safetyScore = 0 }
        coverCacheTime = now
        return nil, 0
    end

    local obstacle = rayResult.Instance
    local position = rayResult.Position

    local region = Region3.new(
        position - Vector3.new(COVER_SIZE, COVER_SIZE, COVER_SIZE) / 2,
        position + Vector3.new(COVER_SIZE, COVER_SIZE, COVER_SIZE) / 2
    )

    local tallest = 0

    for _, part in ipairs(workspace:FindPartsInRegion3(region, nil, math.huge)) do
        if part and part ~= Character and part ~= obstacle then
            if tallest < part.Size.Y then
                tallest = part.Size.Y
            end
        end
    end

    local safety = 0
    if tallest >= 4 then
        safety = math.min(tallest / 10, 1)
    end

    coverCache = { coverPosition = position, safetyScore = safety }
    coverCacheTime = now

    return position, safety
end

----------------------------------------------------------------
-- Target scoring
----------------------------------------------------------------

--- Bonus for attacking whoever a teammate is already fighting.
local function teamFocusBonus(player)
    if not aiTeamFocus then
        return 0
    end

    local theirRoot = rootOf(player)
    if not theirRoot then
        return 0
    end

    for _, teammate in ipairs(Players:GetPlayers()) do
        if teammate ~= LocalPlayer and isOnSameTeam(teammate) then
            local teammateRoot = rootOf(teammate)

            if teammateRoot and (teammateRoot.Position - theirRoot.Position).Magnitude < 40 then
                return 25
            end
        end
    end

    return 0
end

--- Weighted score for one candidate.  Higher is better.
local function scoreTarget(player, exposure)
    local myPosition = myRoot()
    local theirRoot = rootOf(player)

    if not myPosition or not theirRoot then
        return -math.huge
    end

    local offset = theirRoot.Position - myPosition.Position
    local distance = offset.Magnitude
    local height = offset.Y

    local score = 0

    -- Closer targets are easier to hit.
    score = score + math.max(0, 120 - distance)

    -- Visible targets are worth much more than hidden ones.
    score = score + exposure * 80

    -- Finish wounded players.
    local humanoid = humanoidOf(player)
    if humanoid and humanoid.MaxHealth > 0 then
        score = score + (1 - humanoid.Health / humanoid.MaxHealth) * 50
    end

    if aiVerticalControl then
        -- Someone on high ground is hard to trade with; someone below is
        -- free damage.
        if height > HIGH_GROUND_PENALTY then
            score = score - math.min((height - HIGH_GROUND_PENALTY) * 3, 80)
        elseif height < -LOW_GROUND_BONUS then
            score = score + math.min((-height - LOW_GROUND_BONUS) * 2, 30)
        end
    end

    score = score + teamFocusBonus(player)

    return score
end

--- Every enemy inside `maxDistance`, most threatening first.
local function getThreats(maxDistance)
    local myPosition = myRoot()
    if not myPosition then
        return {}
    end

    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isOnSameTeam(player) then
            local root = rootOf(player)
            local humanoid = humanoidOf(player)

            if root and humanoid and humanoid.Health > 0 then
                local offset = root.Position - myPosition.Position
                local distance = offset.Magnitude

                if distance <= maxDistance then
                    -- How much is this player facing us?
                    local facing = 0
                    if distance > 0.001 then
                        facing = math.max(0, root.CFrame.LookVector:Dot((myPosition.Position - root.Position).Unit))
                    end

                    local threat = (1 - distance / maxDistance) * 60 + facing * 40

                    table.insert(list, {
                        player = player,
                        root = root,
                        distance = distance,
                        threat = threat,
                    })
                end
            end
        end
    end

    table.sort(list, function(a, b)
        return a.threat > b.threat
    end)

    while #list > THREAT_LIMIT do
        table.remove(list)
    end

    return list
end

--- Best enemy to fight right now.
-- @return Player|nil, number score
getOptimalTarget = function()
    local now = tick()

    -- Keep the current target for half a second so the bot does not
    -- flip-flop between two equally good candidates.
    if now - aiTargetCacheTime < 0.5 and aiTarget and characterOf(aiTarget) then
        return aiTarget, aiTargetScore
    end

    local candidates = getAllPlayers()

    if #candidates == 0 then
        aiTarget = nil
        aiTargetScore = 0
        aiTargetCacheTime = now
        return nil, 0
    end

    local myPosition = myRoot()

    -- Distance to each candidate, computed once.  A manual scan is used
    -- instead of table.sort so a nil character can never upset the order
    -- function (Luau treats that as undefined behaviour).
    local ranked = {}

    for _, player in ipairs(candidates) do
        local root = rootOf(player)

        if root and myPosition then
            table.insert(ranked, {
                player = player,
                distance = (root.Position - myPosition.Position).Magnitude,
            })
        end
    end

    -- Insertion sort by distance: the list is tiny (a server's players).
    for index = 2, #ranked do
        local entry = ranked[index]
        local cursor = index - 1

        while cursor >= 1 and ranked[cursor].distance > entry.distance do
            ranked[cursor + 1] = ranked[cursor]
            cursor = cursor - 1
        end

        ranked[cursor + 1] = entry
    end

    -- Only spend raycasts on the few closest candidates.
    local budget = math.min(#ranked, MAX_EVALUATED_TARGETS)

    local best = nil
    local bestScore = -math.huge

    for index = 1, budget do
        local entry = ranked[index]

        if entry.distance <= aiEngageDistance then
            local exposure = calculateExposure(entry.player)
            local score = aiSmartTargeting and scoreTarget(entry.player, exposure) or exposure

            if score > bestScore then
                bestScore = score
                best = entry.player
            end
        end
    end

    aiTarget = best
    aiTargetScore = bestScore == -math.huge and 0 or bestScore
    aiTargetCacheTime = now

    return best, aiTargetScore
end

----------------------------------------------------------------
-- Obstacles / facing
----------------------------------------------------------------

--- Whether the bot is about to walk into a low ledge.
checkObstacleAhead = function(direction, distance)
    local root = myRoot()
    if not root or not Character then
        return false
    end

    local origin = root.Position + Vector3.new(0, 1, 0)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { Character }

    local rayResult = workspace:Raycast(origin, direction * distance, rayParams)

    if not rayResult then
        return false
    end

    local height = rayResult.Position.Y - origin.Y
    return height > 2 and height < 8
end

--- Whether the straight line to `player` is interrupted.
checkTargetBlocked = function(player)
    local root = myRoot()
    local theirCharacter = characterOf(player)
    local theirRoot = rootOf(player)

    if not root or not theirRoot or not theirCharacter then
        return false
    end

    local theirHead = theirCharacter:FindFirstChild("Head")
    if not theirHead then
        return false
    end

    local origin = root.Position + Vector3.new(0, 2, 0)
    local offset = theirHead.Position + Vector3.new(0, 2, 0) - origin
    local distance = offset.Magnitude
    local direction = offset.Unit

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = { Character, theirCharacter }

    if workspace:Raycast(origin, direction * distance, rayParams) then
        -- Blocked lower down, but maybe not from a jump-height origin.
        if not workspace:Raycast(origin + Vector3.new(0, 6, 0), direction * distance, rayParams) then
            return true
        end
    end

    return false
end

--- Turns the body towards `player`.
--
-- Writing `HumanoidRootPart.CFrame` resets the humanoid's velocity, so this
-- is only called right before a shot (and when standing still), never every
-- tick — otherwise the character is pinned in place and never walks.
rotateCharacterToTarget = function(player, snap)
    local root = myRoot()
    local theirRoot = rootOf(player)

    if not root or not theirRoot then
        return
    end

    local direction = flatDirection(root.Position, theirRoot.Position)
    if direction == Vector3.zero then
        return
    end

    -- Already facing it closely enough: leave the CFrame alone.
    local facing = root.CFrame.LookVector:Dot(direction)
    if facing > 0.98 then
        return
    end

    local desired = CFrame.lookAt(root.Position, root.Position + direction)
    local alpha = 0.5

    if snap then
        -- If the target is behind us, turn fast so the shot does not
        -- come out of the character's back.
        alpha = facing < 0 and 1 or 0.7
    end

    root.CFrame = root.CFrame:Lerp(desired, alpha)
end

----------------------------------------------------------------
-- Dodging
----------------------------------------------------------------

--- Perpendicular dodge offset for the configured dodge style.
-- @return Vector3 offset, boolean jump
local function dodgeOffset(theirRoot, root)
    local perpendicular = perpendicularDirection(root.Position, theirRoot.Position)
    local now = tick()
    local offset = Vector3.zero
    local jump = false

    if dodgeStyle == "Serpentine" then
        strafePhase = strafePhase + 0.1
        offset = perpendicular * (math.sin(strafePhase * 3) * 3)
    elseif dodgeStyle == "Jump Spam" then
        if now - lastDodgeTime > 0.15 then
            dodgeDirection = dodgeDirection * -1
            lastDodgeTime = now
        end

        offset = perpendicular * dodgeDirection * 8
        jump = true
    elseif dodgeStyle == "Random" then
        if now - lastDodgeTime > math.random(0.2, 0.6) then
            local side = math.random() > 0.5 and 1 or -1
            local angle = math.random(-math.pi, math.pi)

            offset = perpendicular:RotateBy(CFrame.Angles(0, angle, 0)) * side * math.random(2, 5)
            lastDodgeTime = now
        end
    else
        -- Zigzag
        if now - lastDodgeTime > 0.5 then
            dodgeDirection = dodgeDirection * -1
            lastDodgeTime = now
        end

        offset = perpendicular * dodgeDirection * 3
    end

    return offset, jump
end

--- Applies one dodge move relative to the current target.
performDodge = function(style)
    local root = myRoot()
    local humanoid = myHumanoid()
    local theirRoot = aiTarget and rootOf(aiTarget)

    if not root or not humanoid or not theirRoot then
        return
    end

    local offset = dodgeOffset(theirRoot, root)
    humanoid:Move(root.CFrame.LookVector + offset)
end

----------------------------------------------------------------
-- Pathfinding
----------------------------------------------------------------

--- Pathfinds towards `player` and returns the waypoint list.
-- @param mode "Aggressive Push" | "Combat Strafe" | "Reposition"
advancedPathfind = function(player, mode)
    local root = myRoot()
    local theirRoot = rootOf(player)

    if not root or not theirRoot then
        return nil
    end

    local now = tick()

    -- Reuse the previous path while it is still relevant.
    if not aiRandomPaths
        and cachedPathTarget == player
        and now - cachedPathTime < 0.5
    then
        local targetMoved = (theirRoot.Position - pathCache.targetPosition).Magnitude
        local selfMoved = pathCache.playerPosition
            and (root.Position - pathCache.playerPosition).Magnitude
            or math.huge

        if targetMoved < 10 and selfMoved < 5 then
            return pathCache.path
        end
    end

    local destination = theirRoot.Position

    -- "Combat Strafe" stops short of the target, at about optimal range.
    if mode == "Combat Strafe" then
        local direction = (destination - root.Position).Unit
        destination = root.Position
            + direction * aiOptimalRange
            + direction:Cross(Vector3.new(0, 1, 0)).Unit * aiOptimalRange * 0.5
    end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = false,
        WaypointSpacing = 4,
    })

    local ok = pcall(function()
        path:ComputeAsync(root.Position, destination)
    end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        return nil
    end

    local waypoints = {}

    for index, waypoint in ipairs(path:GetWaypoints()) do
        local position = waypoint.Position

        -- Aggressive push jitters the middle waypoints so the bot does not
        -- walk in a perfectly straight line.
        if mode == "Aggressive Push"
            and index > 1
            and index < #path:GetWaypoints()
            and index % 2 == 0
        then
            position = position + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
        end

        table.insert(waypoints, {
            Position = position,
            Action = waypoint.Action,
        })
    end

    pathCache = {
        path = waypoints,
        targetPosition = theirRoot.Position,
        playerPosition = root.Position,
    }

    cachedPathTarget = player
    cachedPathTime = now

    return waypoints
end

----------------------------------------------------------------
-- State machine
----------------------------------------------------------------

--- Decides which behaviour the bot should use this tick.
updateAIState = function()
    if not aiTarget or not characterOf(aiTarget) then
        aiState = "IDLE"
        return
    end

    local root = myRoot()
    local humanoid = myHumanoid()
    local theirRoot = rootOf(aiTarget)

    if not root or not theirRoot then
        aiState = "IDLE"
        return
    end

    local offset = theirRoot.Position - root.Position
    local distance = offset.Magnitude
    local visible = isPlayerInView(aiTarget)

    -- Break off and heal when we are about to die.
    if aiRetreatHealth > 0 and humanoid and humanoid.Health <= aiRetreatHealth then
        aiState = "RETREAT"
        return
    end

    -- Big height difference and no shot: go find a ramp instead of
    -- plinking at a wall.
    if aiVerticalControl and math.abs(offset.Y) > HEIGHT_TOLERANCE and not visible then
        aiState = "REPOSITION"
        return
    end

    if distance < aiOptimalRange * 0.6 then
        aiState = visible and "STRAFE" or "REPOSITION"
        return
    end

    if distance >= aiEngageDistance then
        aiState = "APPROACH"
        return
    end

    if not visible then
        -- Close by: shuffle sideways until there is a line of sight.
        -- Far away: actually walk to them instead of wiggling on the spot.
        if distance < aiOptimalRange * 2 then
            aiState = "PEEK"
        else
            aiState = "APPROACH"
        end

        return
    end

    aiState = "ENGAGE"
end

----------------------------------------------------------------
-- Camera
----------------------------------------------------------------

--- Keeps the camera on the AI's target when a match is running.
trackTargetCamera = function(player)
    if not player or not characterOf(player) then
        return
    end

    local inMatch = isInGame()

    if not inMatch then
        if aiOwnsAimbot and AimbotEnabled then
            AimbotEnabled = false
            stopAimbot()
            aiOwnsAimbot = false
        end

        return
    end

    local character = characterOf(player)
    local headPart = character:FindFirstChild(TargetPart) or character:FindFirstChild("Head")
    if not headPart then
        return
    end

    local _, onScreen = Camera:WorldToScreenPoint(headPart.Position)

    if onScreen then
        if not AimbotEnabled then
            AimbotEnabled = true
            startAimbot()
            aiOwnsAimbot = true
        end

        return
    end

    -- Target off screen: nudge the camera towards it ourselves.
    local desired = CFrame.new(Camera.CFrame.Position, headPart.Position)

    if AimbotSmoothness > 0 then
        Camera.CFrame = Camera.CFrame:Lerp(desired, 1 / (AimbotSmoothness * 2))
    else
        Camera.CFrame = desired
    end
end

----------------------------------------------------------------
-- Debug overlay
----------------------------------------------------------------

--- Removes the AI debug drawings.
cleanupAIDebug = function()
    for _, drawing in pairs(aiDebugDrawings) do
        if drawing and drawing.Remove then
            drawing:Remove()
        end
    end

    aiDebugDrawings = {}
end

--- Draws the AI's state, target line, path and cover.
updateAIDebug = function()
    cleanupAIDebug()

    if not aiDebugEnabled then
        return
    end

    local root = myRoot()
    if not root then
        return
    end

    local function newLine(from, to, colour, thickness, transparency)
        local line = Drawing.new("Line")

        line.From = from
        line.To = to
        line.Color = colour
        line.Thickness = thickness
        line.Transparency = transparency

        table.insert(aiDebugDrawings, line)
    end

    local function newText(text, position, size, colour)
        local label = Drawing.new("Text")

        label.Text = text
        label.Size = size
        label.Center = true
        label.Outline = true
        label.Color = colour
        label.Position = position
        label.Font = 2

        table.insert(aiDebugDrawings, label)
    end

    local myPoint, myOnScreen = Camera:WorldToScreenPoint(root.Position)

    if myOnScreen then
        newText("AI State: " .. aiState, Vector2.new(myPoint.X, myPoint.Y - 30), 16, Color3.fromRGB(255, 255, 255))
        newText(string.format("Score: %.0f", aiTargetScore), Vector2.new(myPoint.X, myPoint.Y - 15), 14,
            Color3.fromRGB(255, 255, 255))
    end

    local theirRoot = aiTarget and rootOf(aiTarget)

    if theirRoot then
        local theirPoint, theirOnScreen = Camera:WorldToScreenPoint(theirRoot.Position)

        if theirOnScreen and myOnScreen then
            newLine(Vector2.new(myPoint.X, myPoint.Y), Vector2.new(theirPoint.X, theirPoint.Y),
                Color3.fromRGB(255, 0, 0), 2, 0.5)
        end
    end

    -- Every threat, coloured by how dangerous it is.
    for _, threat in ipairs(aiThreats) do
        if threat.root and threat.root.Parent then
            local point, onScreen = Camera:WorldToScreenPoint(threat.root.Position)

            if onScreen then
                local colour = threat.player == aiTarget
                    and Color3.fromRGB(255, 60, 60)
                    or Color3.fromRGB(255, 180, 0)

                newText(string.format("%.0f", threat.threat), Vector2.new(point.X, point.Y - 40), 13, colour)
            end
        end
    end

    if activePath and #activePath > 0 then
        local previous = nil

        for _, waypoint in ipairs(activePath) do
            local point, onScreen = Camera:WorldToViewportPoint(waypoint.Position)

            if onScreen then
                local current = Vector2.new(point.X, point.Y)

                if previous then
                    newLine(previous, current, Color3.fromRGB(255, 255, 0), 1, 0.7)
                end

                previous = current
            end
        end
    end

    if coverCache.coverPosition then
        local point, onScreen = Camera:WorldToViewportPoint(coverCache.coverPosition)

        if onScreen then
            local radius = 5
            local corners = {
                Vector2.new(point.X - radius, point.Y - radius),
                Vector2.new(point.X + radius, point.Y - radius),
                Vector2.new(point.X + radius, point.Y + radius),
                Vector2.new(point.X - radius, point.Y + radius),
            }

            for index = 1, 4 do
                newLine(corners[index], corners[index % 4 + 1], Color3.fromRGB(0, 0, 255), 2, 0)
            end
        end
    end
end

----------------------------------------------------------------
-- Firing
----------------------------------------------------------------

--- Makes sure something usable is in hand.
local function ensureWeapon()
    local tool = getEquippedWeapon()

    if tool and (tool:FindFirstChild("Fire", true) or tool:FindFirstChild("ThrowSound", true)) then
        return tool
    end

    if not aiAutoEquip then
        return tool
    end

    return equipTool("Gun") or equipTool("Knife") or tool
end

--- Fires at `player` if the shot is available and visible.
-- @return boolean  whether an attack was made
local function fireAtTarget(player)
    local character = characterOf(player)
    if not character then
        return false
    end

    if not isPlayerInView(player) then
        return false
    end

    local tool = ensureWeapon()
    if not tool then
        return false
    end

    -- Knife: stab when close, throw when far.
    if not tool:FindFirstChild("Fire", true) then
        local root = myRoot()
        local theirRoot = rootOf(player)

        if root and theirRoot and (theirRoot.Position - root.Position).Magnitude <= knifeTriggerRange then
            if aiFaceTarget then
                rotateCharacterToTarget(player, true)
            end

            stabKnife(character)
            return true
        end

        if tick() - aiLastFireTime < 0.5 then
            return false
        end

        if aiFaceTarget then
            rotateCharacterToTarget(player, true)
        end

        if throwKnifeAt(player) then
            aiLastFireTime = tick()
            return true
        end

        return false
    end

    -- Gun: honour its cooldown unless the bypass is on.
    local cooldown = tool:GetAttribute("Cooldown") or 0
    local gap = math.max(cooldown, MIN_FIRE_GAP)

    if not GunCooldownBypass and tick() - aiLastFireTime < gap then
        return false
    end

    -- Lead the shot using the target's velocity.
    local aimPosition = nil
    local theirRoot = rootOf(player)

    if aiPrediction and theirRoot then
        local velocity = theirRoot.AssemblyLinearVelocity

        if velocity.Magnitude > 1 then
            aimPosition = (character:FindFirstChild(TargetPart) or character:FindFirstChild("Head")).Position
                + velocity * aiLeadTime
        end
    end

    if aiFaceTarget then
        rotateCharacterToTarget(player, true)
    end

    aiLastFireTime = tick()
    shootGun(character, false, aimPosition)

    return true
end

----------------------------------------------------------------
-- Movement
----------------------------------------------------------------

--- Keeps the footwork honest while engaging.
local function moveInCombat(target)
    local humanoid = myHumanoid()
    local root = myRoot()
    local theirRoot = rootOf(target)

    if not humanoid or not root or not theirRoot then
        return
    end

    local offset = theirRoot.Position - root.Position
    local distance = offset.Magnitude
    local direction = flatDirection(root.Position, theirRoot.Position)
    local dodge, jump = dodgeOffset(theirRoot, root)

    local destination = root.Position

    if aiKeepRange then
        local optimal = math.clamp(aiOptimalRange, 8, math.max(8, aiEngageDistance * 0.6))

        if distance > optimal * 1.2 then
            destination = root.Position + direction * math.min(distance - optimal, 12)
        elseif distance < optimal * 0.75 then
            destination = root.Position - direction * math.min(optimal - distance, 10)
        end
    end

    destination = destination + dodge

    -- Jump over anything low in the way.
    if checkObstacleAhead(direction, 4) and tick() - lastRepathTime > JUMP_COOLDOWN then
        jump = true
    end

    if jump then
        humanoid.Jump = true
    end

    -- Vertical handling: hop when the target is above us.
    if aiVerticalControl and offset.Y > 6 and humanoid.FloorMaterial ~= Enum.Material.Air then
        humanoid.Jump = true
    end

    driveHumanoidTo(destination)
end

--- Walks a path towards `target`, used when ground has to be covered.
local function followPathTo(target)
    local humanoid = myHumanoid()
    local root = myRoot()

    if not humanoid or not root then
        return
    end

    if not activePath or activeWaypoint > #activePath then
        local mode = aiState == "REPOSITION" and "Reposition"
            or (aiState == "RETREAT" and "Reposition" or "Aggressive Push")

        local path = advancedPathfind(target, mode)

        if path and #path > 0 then
            activePath = path
            activeWaypoint = 1
            lastRepathTime = tick()
        end
    end

    if not activePath or activeWaypoint > #activePath then
        -- No path: walk straight at the target as a fallback.
        local theirRoot = rootOf(target)

        if theirRoot then
            driveHumanoidTo(theirRoot.Position)
        end

        return
    end

    local waypoint = activePath[activeWaypoint]
    local now = tick()

    if (root.Position - waypoint.Position).Magnitude < REPATH_DISTANCE
        or now - lastRepathTime > REPATH_TIMEOUT
    then
        activeWaypoint = activeWaypoint + 1
        lastRepathTime = now
    end

    if activeWaypoint > #activePath then
        local theirRoot = rootOf(target)

        if theirRoot then
            driveHumanoidTo(theirRoot.Position)
        end

        return
    end

    waypoint = activePath[activeWaypoint]

    if waypoint.Action == Enum.PathWaypointAction.Jump then
        humanoid.Jump = true
    end

    local direction = (waypoint.Position - root.Position).Unit

    if checkObstacleAhead(direction, 3) then
        humanoid.Jump = true
    end

    local dodge = Vector3.zero
    local theirRoot = rootOf(target)

    if theirRoot and (aiState == "ENGAGE" or aiState == "PEEK") then
        dodge = dodgeOffset(theirRoot, root)
    end

    -- Hop while closing the distance; it keeps momentum and looks alive.
    if aiBhop and aiState == "APPROACH" and humanoid.FloorMaterial ~= Enum.Material.Air then
        humanoid.Jump = true
    end

    driveHumanoidTo(waypoint.Position + dodge)
end

--- Runs away from the nearest threat, preferring cover.
local function retreat()
    local humanoid = myHumanoid()
    local root = myRoot()

    if not humanoid or not root then
        return
    end

    local threat = aiThreats[1]
    if not threat or not threat.root then
        humanoid:MoveTo(root.Position)
        return
    end

    local away = flatDirection(threat.root.Position, root.Position)
    if away == Vector3.zero then
        away = -root.CFrame.LookVector
    end

    local destination = root.Position + away * 25
    local cover, safety = findNearestCover(root.Position, destination)

    if cover and safety > 0.3 then
        destination = cover
    end

    -- Still shoot back while running if the target is visible.
    local dodge = dodgeOffset(threat.root, root)
    driveHumanoidTo(destination + dodge)
end

--- Steps sideways out of cover to get a shot.
local function peek(target)
    local humanoid = myHumanoid()
    local root = myRoot()
    local theirRoot = rootOf(target)

    if not humanoid or not root or not theirRoot then
        return
    end

    local dodge = dodgeOffset(theirRoot, root)
    driveHumanoidTo(root.Position + dodge * 2)
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------

--- One think tick of the bot.
local function aiTick()
    local humanoid = myHumanoid()
    local root = myRoot()

    if not humanoid or not root then
        task.wait(1)
        return
    end

    if not hasWeapon() then
        task.wait(1)
        return
    end

    -- 1. Threat picture.
    aiThreats = getThreats(aiEngageDistance)

    -- 2. Primary target.
    local target = getOptimalTarget()

    -- 3. Stuck detection: if we have not moved for a while, jump and
    --    throw the path away.
    local now = tick()

    if not lastPosition then
        lastPosition = root.Position
        lastPathTime = now
    elseif now - lastPathTime > STUCK_WINDOW then
        if (root.Position - lastPosition).Magnitude < STUCK_DISTANCE then
            stuckCount = stuckCount + 1

            if stuckCount >= 2 then
                humanoid.Jump = true
                stuckCount = 0
                activePath = nil
                activeWaypoint = 1
                cachedPathTarget = nil
            end
        else
            stuckCount = 0
        end

        lastPosition = root.Position
        lastPathTime = now
    end

    -- 4. Act.
    updateAIState()

    if not target then
        -- Nothing to fight: wander around instead of standing still.
        aiStatusText = "Patrolling"

        if not patrolTarget
            or (root.Position - patrolTarget).Magnitude < 3
            or tick() - lastPatrolTime > 6
        then
            lastPatrolTime = tick()
            patrolTarget = root.Position + Vector3.new(math.random(-25, 25), 0, math.random(-25, 25))
        end

        driveHumanoidTo(patrolTarget)

        if aiBhop and humanoid.FloorMaterial ~= Enum.Material.Air then
            humanoid.Jump = true
        end

        updateAIDebug()
        return
    end

    local theirRoot = rootOf(target)

    if not theirRoot then
        aiStatusText = "No target"
        humanoid:MoveTo(root.Position)
        updateAIDebug()
        return
    end

    local distance = (theirRoot.Position - root.Position).Magnitude

    -- Note: the body is only turned inside fireAtTarget.  Rotating every
    -- tick writes the root CFrame and kills the humanoid's walking velocity.
    if aiState == "RETREAT" then
        aiStatusText = string.format("Retreating (%.0f HP)", humanoid.Health)
        retreat()
        trackTargetCamera(target)
        fireAtTarget(target)
    elseif aiState == "REPOSITION" or aiState == "APPROACH" then
        aiStatusText = aiState == "REPOSITION"
            and ("Flanking " .. target.Name)
            or ("Hunting " .. target.Name)

        followPathTo(target)
        trackTargetCamera(target)
        fireAtTarget(target)
    elseif aiState == "PEEK" then
        aiStatusText = "Peeking " .. target.Name
        peek(target)
        trackTargetCamera(target)
    else
        aiStatusText = string.format("Dueling %s (%.0fm)", target.Name, distance)
        trackTargetCamera(target)

        if aiState == "STRAFE" then
            performDodge(dodgeStyle)
        else
            moveInCombat(target)
        end

        fireAtTarget(target)
    end

    updateAIDebug()
end

