----------------------------------------------------------------
-- ui/tab_config
----------------------------------------------------------------
-- Save / load / delete configs, the auto-load picker and its status.
----------------------------------------------------------------

local configNameState = setting("ConfigName", "string", "Default_Config")
local configIndexState = setting("ConfigIndex", "number", 1)

-- Refreshed every frame so the dropdown follows the folder.
local configList = {}

tabBodies.Config = function()
    ----------------------------------------------------------------
    -- Save
    ----------------------------------------------------------------

    Iris.SeparatorText({ "Save Configuration" })

    Iris.InputText({ "Config Name" }, { text = configNameState })

    if Iris.Button({ "Save Config" }).clicked() then
        local name = configNameState:get()

        if name and name ~= "" then
            if saveConfig(name) then
                showNotice("Config", "Saved config: " .. name)
            else
                showNotice("Config", "Could not save that config.")
            end
        end
    end

    ----------------------------------------------------------------
    -- Load / delete
    ----------------------------------------------------------------

    Iris.SeparatorText({ "Load Configuration" })

    configList = getConfigList()

    local index = math.clamp(configIndexState:get(), 1, math.max(#configList, 1))
    configIndexState:set(index)

    Iris.Combo({ "Select Config" }, { index = configIndexState })

    -- The list length changes as configs are added/removed; scoping the
    -- ids keeps the widgets after it stable.
    Iris.PushId("config-list")

    for itemIndex, name in ipairs(configList) do
        Iris.Selectable({ name, itemIndex }, { index = configIndexState })
    end

    Iris.PopId()
    Iris.End()

    if Iris.Button({ "Load Selected Config" }).clicked() then
        local name = configList[configIndexState:get()]

        if name then
            if loadConfig(name) then
                showNotice("Config", "Loaded config: " .. name)
            else
                showNotice("Config", "Could not load that config.")
            end
        end
    end

    if Iris.Button({ "Delete Selected Config" }).clicked() then
        local name = configList[configIndexState:get()]

        if name and deleteConfig(name) then
            showNotice("Config", "Deleted config: " .. name)
        end
    end

    Iris.Separator()

    ----------------------------------------------------------------
    -- Auto-load
    ----------------------------------------------------------------

    if Iris.Button({ "Set as Auto-Load Config" }).clicked() then
        local name = configList[configIndexState:get()]

        if name then
            setAutoLoadConfig(name)
            showNotice("Config", "Auto-load set to: " .. name)
        end
    end

    if Iris.Button({ "Clear Auto-Load" }).clicked() then
        setAutoLoadConfig(nil)
    end

    local autoLoad = getAutoLoadConfig()

    if autoLoad and autoLoad ~= "" then
        Iris.Text({ "Auto-Load: " .. autoLoad })
    else
        Iris.Text({ "Auto-Load: None" })
    end
end

----------------------------------------------------------------
-- ui/finalize
----------------------------------------------------------------
-- Last piece of the script: start the background services, apply the
-- auto-load config once the UI has registered every setting, and make
-- the hub reload itself after a teleport.
----------------------------------------------------------------

startAutoAds()
checkForOwners()

-- The settings registry fills in on the first rendered frame, so the
-- auto-load config is applied a moment later.
task.spawn(function()
    task.wait(1)

    local autoLoad = getAutoLoadConfig()

    if autoLoad and autoLoad ~= "" then
        local path = configFolder .. "/" .. autoLoad .. ".json"

        if isfile(path) then
            loadConfig(autoLoad)
        end
    end
end)

local RELOAD_URL = nil

if RELOAD_URL then
    queue_on_teleport(
        "\n    task.wait(5)\n    loadstring(game:HttpGet(\"" .. RELOAD_URL .. "\"))()\n"
    )
end
