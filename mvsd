----------------------------------------------------------------
-- ui/tab_keybinds
----------------------------------------------------------------
-- Iris has no keybind widget, so this implements one: click a row, press
-- a key, and the action is bound.  Insert still toggles the window.
----------------------------------------------------------------

keybindStates = {}
keybindActions = {}

-- The keybind currently waiting for a key press (a keybind name).
listeningFor = nil

local function keybindLabel(keyCode)
    if not keyCode or keyCode == Enum.KeyCode.Unknown then
        return "None"
    end

    return keyCode.Name
end

--- Returns (creating on first use) the State for one keybind.
local function keybindState(name, initial)
    local state = keybindStates[name]

    if not state then
        state = setting("Keybind_" .. name, "enum", initial or Enum.KeyCode.Unknown)
        keybindStates[name] = state
    end

    return state
end

--- One keybind row.  `action` runs when the bound key is pressed.
local function keybindRow(name, label, initial, action)
    local state = keybindState(name, initial)

    if Iris.Button({ label .. ": " .. keybindLabel(state:get()) }).clicked() then
        listeningFor = name
    end

    keybindActions[name] = action
end

-- Capture the next key press, or dispatch a bound action.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if listeningFor then
        local state = keybindStates[listeningFor]

        if state then
            state:set(input.KeyCode)
        end

        listeningFor = nil
        return
    end

    for name, action in pairs(keybindActions) do
        local state = keybindStates[name]

        if state and state:get() == input.KeyCode then
            action()
        end
    end
end)

