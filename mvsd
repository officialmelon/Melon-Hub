----------------------------------------------------------------
-- modules/gun_controller
----------------------------------------------------------------
-- Replacement for the game's GunController.
--
-- The stock controller is disabled by the hub and this one takes over:
-- it hooks mouse / touch input, raycasts from the camera, renders the
-- tracer with the game's BulletRenderer and fires the ShootGun remote.
--
-- Wire format (verified against the live GunController):
--   ShootGun:FireServer(origin, aimPosition, hitInstance?, hitPosition?)
----------------------------------------------------------------

customGunController = function()
    local ReplicatedStorage_ = game:GetService("ReplicatedStorage")
    local CollectionService_ = game:GetService("CollectionService")
    local UserInputService = game:GetService("UserInputService")
    local Players_ = game:GetService("Players")
    local Workspace = game:GetService("Workspace")

    local CharacterRayOrigin = require(ReplicatedStorage_.Modules.CharacterRayOrigin)
    local BulletRenderer = require(ReplicatedStorage_.Modules.BulletRenderer)
    local WeaponRaycast = require(ReplicatedStorage_.Modules.WeaponRaycast)
    local CollisionGroups = require(ReplicatedStorage_.Modules.CollisionGroups)
    local Maid = require(ReplicatedStorage_.Modules.Util.Maid)
    local Tags = require(ReplicatedStorage_.Modules.Tags)

    local LocalPlayer_ = Players_.LocalPlayer
    local Mouse_ = LocalPlayer_:GetMouse()
    local Camera_ = Workspace.CurrentCamera
    local Character_ = LocalPlayer_.Character
    if not Character_ then
        return
    end

    local ShootGun = ReplicatedStorage_.Remotes.ShootGun

    local maid = Maid.new()
    local lastShotTime = nil

    ----------------------------------------------------------------
    -- Wall-hack filter
    ----------------------------------------------------------------

    --- Every BasePart in the workspace that does not belong to another
    -- player's character.  Feeding this to the raycast as a blacklist
    -- makes shots ignore geometry entirely.
    local function getWallhackParts()
        local parts = {}

        if not WallHacksEnabled then
            return parts
        end

        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                local belongsToPlayer = false

                for _, player in ipairs(Players_:GetPlayers()) do
                    local character = player.Character
                    if character and player ~= LocalPlayer_ and part:IsDescendantOf(character) then
                        belongsToPlayer = true
                        break
                    end
                end

                if not belongsToPlayer then
                    table.insert(parts, part)
                end
            end
        end

        return parts
    end

    ----------------------------------------------------------------
    -- Firing
    ----------------------------------------------------------------

    local function onGunAdded(gunTool)
        if not gunTool:IsA("Tool") or not CollectionService_:HasTag(gunTool, Tags.GUN_TOOL) then
            return
        end

        maid:DoCleaning()
        maid:GiveTask(gunTool.AncestryChanged:Connect(function()
            if not gunTool:IsDescendantOf(Character_) then
                maid:DoCleaning()
            end
        end))

        local cooldown = gunTool:GetAttribute("Cooldown") or 0

        --- Fires one shot.  `targetPosition` is set by touch input and by
        -- the silent-aim path; when it is absent the shot follows the mouse.
        local function fireGun(targetPosition)
            if not gunTool.Enabled then
                return
            end

            if not GunCooldownBypass and lastShotTime and cooldown > tick() - lastShotTime then
                return
            end

            local muzzle = gunTool:FindFirstChild("Muzzle", true)
            if not muzzle then
                return
            end

            lastShotTime = tick()

            local aimPosition = targetPosition
                or Mouse_.Hit.Position + 100 * Mouse_.UnitRay.Direction

            -- Silent aim: swap the aim point for the nearest enemy head.
            if SilentAimEnabled and not targetPosition then
                local target = getClosestPlayerToMouse()
                local head = target and target.Character and target.Character:FindFirstChild("Head")

                if head then
                    aimPosition = head.Position
                end
            end

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
            rayParams.CollisionGroup = CollisionGroups.SCREEN_RAYCAST

            if WallHacksEnabled then
                rayParams.FilterDescendantsInstances = getWallhackParts()
            end

            local origin = Camera_.CFrame.Position
            local rayResult = Workspace:Raycast(origin, aimPosition - origin, rayParams)

            local rayOrigin = CharacterRayOrigin(Character_)
            local hitPosition = rayResult and rayResult.Position or aimPosition

            -- Without wall hacks the shot is pulled back to whatever the
            -- ray hit; with them it keeps the requested aim point.
            local firePosition = aimPosition
            if not WallHacksEnabled and rayResult then
                firePosition = rayResult.Position
            end

            BulletRenderer(muzzle.WorldPosition, hitPosition, gunTool:GetAttribute("BulletType"))

            local fireSound = gunTool:FindFirstChild("Fire")
            if fireSound then
                fireSound:Play()
            end

            gunTool:Activate()

            local hitInstance = rayResult and rayResult.Instance or nil
            ShootGun:FireServer(rayOrigin, firePosition, hitInstance, rayResult and rayResult.Position)
        end

        maid:GiveTask(UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then
                return
            end

            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.KeyCode == Enum.KeyCode.ButtonR2
            then
                fireGun()
            end
        end))

        maid:GiveTask(UserInputService.TouchTapInWorld:Connect(function(tapPosition, tapProcessed)
            if tapProcessed then
                return
            end

            fireGun(WeaponRaycast.convertScreenPointToVector3(tapPosition, 2000))
        end))
    end

    ----------------------------------------------------------------
    -- Bind to the character
    ----------------------------------------------------------------

    Character_.ChildAdded:Connect(onGunAdded)

    for _, child in ipairs(Character_:GetChildren()) do
        onGunAdded(child)
    end
end

