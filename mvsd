    local Tags = require(ReplicatedStorage_.Modules.Tags)
    local Hitbox = require(ReplicatedStorage_.Modules.Hitbox)

    -- Loaded for its side effect: registers the game's collision groups.
    require(ReplicatedStorage_.Modules.CollisionGroups)

    local LocalPlayer_ = Players_.LocalPlayer
    local Mouse_ = LocalPlayer_:GetMouse()
    local Character_ = LocalPlayer_.Character
    if not Character_ then
        return
    end

    local Stab = ReplicatedStorage_.Remotes.Stab
    local ThrowHit = ReplicatedStorage_.Remotes.ThrowHit
    local ThrowStart = ReplicatedStorage_.Remotes.ThrowStart

    local maid = Maid.new()
    local touchMode = false

    ----------------------------------------------------------------
    -- Handle visibility
    ----------------------------------------------------------------

    --- Hides (or restores) the knife model while it is in flight.
    local function setKnifeTransparency(tool, transparency)
        local handle = tool and tool:FindFirstChild("RightHandle")
        if not handle then
            return
        end

        handle.LocalTransparencyModifier = transparency

        for _, descendant in ipairs(handle:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.LocalTransparencyModifier = transparency
            elseif descendant:IsA("Trail") then
                descendant.Enabled = transparency < 1
            end
        end
    end

    ----------------------------------------------------------------
    -- Throwing
    ----------------------------------------------------------------

    local function throwKnife(tool, targetPosition)
        local handle = tool:FindFirstChild("RightHandle")
        if not handle then
            return
        end

        local origin = CharacterRayOrigin(Character_)
        if not origin then
            return
        end

        -- Touch input passes an explicit world position, mouse input does not.
        targetPosition = targetPosition or Mouse_.Hit.Position

        local direction = (targetPosition - origin).Unit
        local fireOrigin = origin

        -- Wall hack: keep the request direction but start the knife at the
        -- victim instead of at the thrower.
        if KnifeWallHacksEnabled then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
            rayParams.FilterDescendantsInstances = { Character_ }

            local rayResult = Workspace:Raycast(origin, direction * 1000, rayParams)

            if rayResult and rayResult.Instance then
                local victim = rayResult.Instance.Parent
                if victim and victim:FindFirstChild("Humanoid") then
                    local head = victim:FindFirstChild(TargetPart) or victim:FindFirstChild("Head")
                    if head then
                        fireOrigin = head.Position
                        direction = (targetPosition - fireOrigin).Unit
                    end
                end
            end
        end

        ThrowStart:FireServer(fireOrigin, direction)

        local knifeClone = handle:Clone()
        setKnifeTransparency(tool, 1)

        KnifeProjectileController({
            Speed = tool:GetAttribute("ThrowSpeed") or 100,
            KnifeProjectile = knifeClone,
            Direction = direction,
            Origin = fireOrigin,
        }, function(result)
            local hitInstance = result and result.Instance or nil
            local hitPosition = result and result.Position or nil

            ThrowHit:FireServer(hitInstance, hitPosition)
        end)

        task.wait(0.1)
        setKnifeTransparency(tool, 0)
    end

    ----------------------------------------------------------------
    -- Stabbing
    ----------------------------------------------------------------

    local function setupHitbox(tool)
        -- One stab per victim per activation.
        local hitPlayers = {}

        if KnifeHitboxEnabled then
            local handle = tool:FindFirstChild("RightHandle")

            if handle then
                local originalSize = handle.Size

                handle.Size = Vector3.new(KnifeHitboxSize, KnifeHitboxSize, KnifeHitboxSize)
                handle.Transparency = 0.8

                maid:GiveTask(function()
                    handle.Size = originalSize
                    handle.Transparency = 0
                end)
            end
        end

        local hitbox = Hitbox(tool, function(hitPart)
            local victim = hitPart.Instance.Parent
            if not victim or not victim:FindFirstChild("Humanoid") then
                return
            end

            if hitPlayers[victim] then
                return
            end

            hitPlayers[victim] = true
            Stab:FireServer(hitPart.Instance)
        end)

        maid:GiveTask(tool:GetAttributeChangedSignal("IsActivated"):Connect(function()
            if tool:GetAttribute("IsActivated") then
                hitbox:Activate()
                return
            end

            hitPlayers = {}
            hitbox:Deactivate()
        end))

        maid:GiveTask(function()
            hitbox:Deactivate()
        end)
    end

    ----------------------------------------------------------------
    -- Equipping
    ----------------------------------------------------------------

    local function onKnifeAdded(tool)
        if not tool:IsA("Tool") or not CollectionService_:HasTag(tool, Tags.KNIFE_TOOL) then
            return
        end

        maid:DoCleaning()

        maid:GiveTask(tool.AncestryChanged:Connect(function()
            if not tool:IsDescendantOf(Character_) then
                maid:DoCleaning()
            end
        end))

        local cooldown = tool:GetAttribute("Cooldown") or 0.5
        local lastThrow = 0

        tool.ManualActivationOnly = touchMode
        setupHitbox(tool)

        --- Shared cooldown gate for keyboard and touch throws.
        local function canThrow()
            if KnifeCooldownBypass then
                return true
            end

            return tick() - lastThrow >= cooldown
        end

        ContextActionService:BindAction("Throw", function(actionName, inputState)
            if actionName ~= "Throw" or inputState ~= Enum.UserInputState.Begin then
                return
            end

            if not canThrow() then
                return
            end

            lastThrow = tick()
            throwKnife(tool, nil)
        end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonL2)

        maid:GiveTask(function()
            ContextActionService:UnbindAction("Throw")
        end)

        maid:GiveTask(UserInputService.TouchTapInWorld:Connect(function(tapPosition, tapProcessed)
            if not touchMode or tapProcessed then
                return
            end

            if not canThrow() then
                return
            end

            lastThrow = tick()

            local worldPosition = WeaponRaycast.convertScreenPointToVector3(tapPosition, 2000)
            throwKnife(tool, worldPosition)
        end))
    end

    ----------------------------------------------------------------
    -- Bind to the character
    ----------------------------------------------------------------

    Character_.ChildAdded:Connect(onKnifeAdded)

    for _, child in ipairs(Character_:GetChildren()) do
        onKnifeAdded(child)
    end
end

----------------------------------------------------------------
-- combat/weapon_utils
----------------------------------------------------------------
-- Small helpers shared by the shooting, stabbing, auto-fire and AI
-- code: ray origin, tool lookup, tool switching and knife throwing.
----------------------------------------------------------------

--- Ray origin for a character: the front edge of its root part.
-- @return Vector3|nil
local function getRayOrigin(character)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    return (root.CFrame * CFrame.new(0, 0, root.Size.Z / 2)).Position
end

--- The tool the local character is currently holding.
-- @return Tool|nil
getEquippedWeapon = function()
    return Character:FindFirstChildOfClass("Tool")
end

--- Pulls a gun or knife out of the backpack and equips it.
-- The two tool kinds are told apart by the sounds they ship with.
-- @param toolKind "Gun" | "Knife"
-- @return Tool|nil
local function equipTool(toolKind)
    local equipped = getEquippedWeapon()
    if equipped then
        equipped.Parent = Backpack
    end

    for _, child in ipairs(Backpack:GetChildren()) do
        if child:IsA("Tool") then
            local fireSound = child:FindFirstChild("Fire", true)
            local throwSound = child:FindFirstChild("ThrowSound", true)

            local isGun = toolKind == "Gun" and fireSound
            local isKnife = toolKind == "Knife" and throwSound

            if isGun or isKnife then
                child.Parent = Character
                return child
            end
        end
    end

    return nil
end

--- Throws the equipped knife at `target`'s head.
-- Fires ThrowStart, spawns the game's knife projectile and reports the
-- impact back through ThrowHit.
-- @param target Player|Model
-- @return boolean  whether a throw was started
local function throwKnifeAt(target)
    local character = target and target.Character
    if not character then
        return false
    end

    if not Character then
        return false
    end

    local head = character:FindFirstChild(TargetPart) or character:FindFirstChild("Head")
    if not head then
        return false
    end

    local tool = getEquippedWeapon()
    if not (tool and tool:FindFirstChild("ThrowSound", true)) then
        return false
    end

    local handle = tool:FindFirstChild("RightHandle")
    local root = Character:FindFirstChild("HumanoidRootPart")

    if not handle or not root then
        return false
    end

    local targetPosition = head.Position
    local origin = root.Position

    -- Wall hack: start the knife at the victim, not at the thrower.
    if KnifeWallHacksEnabled then
        origin = targetPosition
    end

    local direction = (targetPosition - root.Position).Unit

    ReplicatedStorage.Remotes.ThrowStart:FireServer(origin, direction)

    local knifeClone = handle:Clone()

    require(ReplicatedStorage.Modules.KnifeProjectileController)({
        Speed = tool:GetAttribute("ThrowSpeed") or 100,
        KnifeProjectile = knifeClone,
        Direction = direction,
        Origin = origin,
    }, function(result)
        local hitInstance = result and result.Instance or nil
        local hitPosition = result and result.Position or nil

        ReplicatedStorage.Remotes.ThrowHit:FireServer(hitInstance, hitPosition)
    end)

    return true
end

----------------------------------------------------------------
-- combat/shoot
----------------------------------------------------------------
-- Blind-fire helper used by kill-all, auto fire and the AI.  It does
-- not need the target to be in view: it aims at the target's head,
-- optionally adds spread, optionally ignores walls, and pushes the
-- result through the ShootGun remote.
----------------------------------------------------------------

--- Fires one shot at `target`.
-- @param target Player|Model
-- @param randomize? boolean  add the configured spread
-- @param overridePosition? Vector3  aim here instead of at the head
--        (used by the AI to lead a moving target)
shootGun = function(target, randomize, overridePosition)
    if not target then
        return
    end

    if target:IsA("Player") then
        target = target.Character
    end

    if not target then
        return
    end

    local headPart = target:FindFirstChild(TargetPart) or target:FindFirstChild("Head")
    if not headPart then
        return
    end

    local aimPosition = overridePosition or headPart.Position

    if randomize then
        local offset = Vector3.new(
            (math.random() * 2 - 1) * aimSpread,
            (math.random() * 2 - 1) * aimSpread,
            (math.random() * 2 - 1) * aimSpread
        )

        aimPosition = aimPosition + offset
    end

    -- Without wall hacks the shot stops at whatever it hits first.
    local hitPosition = aimPosition

    if not WallHacksEnabled then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        rayParams.FilterDescendantsInstances = { Character, target }

        local rayResult = workspace:Raycast(Camera.CFrame.Position, aimPosition - Camera.CFrame.Position, rayParams)
        if rayResult then
            hitPosition = rayResult.Position
        end
    end

    -- Reuse the game's gun feedback when the player is actually holding one.
    local tool = getEquippedWeapon()
    if tool and tool:FindFirstChild("Fire", true) then
        local fireSound = tool:FindFirstChild("Fire")
        if fireSound then
            fireSound:Play()
        end

        local muzzle = tool:FindFirstChild("Muzzle", true)
        if muzzle then
            require(ReplicatedStorage.Modules.BulletRenderer)(
                muzzle.WorldPosition,
                hitPosition,
                tool:GetAttribute("BulletType")
            )
        end

        tool:Activate()
    end

    local rayOrigin = getRayOrigin(Character)

    -- With wall hacks the server is told about the requested aim point;
    -- otherwise it gets the point the ray actually reached.
    local firePosition = aimPosition
    if not WallHacksEnabled then
        firePosition = hitPosition
    end

    local args = {}
    packArgs(args, 1, rayOrigin, firePosition, headPart, hitPosition)

    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ShootGun"):FireServer(unpack(args))
end

----------------------------------------------------------------
-- combat/stab
----------------------------------------------------------------
-- Direct stab helper: tells the server to run the knife hit on the
-- target's configured hit part.
----------------------------------------------------------------

--- Stabs `character` at the configured target part.
-- @param character Model
stabKnife = function(character)
    local targetPart = character:FindFirstChild(TargetPart) or character:FindFirstChild("Head")
    if not targetPart then
        return
    end

    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Stab"):FireServer(unpack({ targetPart }))
end

----------------------------------------------------------------
-- combat/visibility
----------------------------------------------------------------
-- Team filtering and line-of-sight checks.
----------------------------------------------------------------

--- Whether `player` is on the local player's team.
-- Always false when the team check is switched off.
isOnSameTeam = function(player)
    if not TeamCheckEnabled then
        return false
    end

    if not player or not LocalPlayer then
        return false
    end

    if not player.Team or not LocalPlayer.Team then
        return false
    end

    return player.Team == LocalPlayer.Team
end

--- Whether the hub can currently "see" `targetPlayer`.
-- "Camera" only accepts targets inside the viewport with a clear ray,
-- "Raycast" only uses the ray, "Both" accepts either.
isPlayerInView = function(targetPlayer)
    local character = targetPlayer.Character
    if not character then
        return false
    end

    if not Character or not Character:FindFirstChild("Head") then
        return false
    end

    local targetHead = character:FindFirstChild("Head")
    if not targetHead then
        return false
    end

    local localHead = Character.Head
    local cameraPosition = Camera.CFrame.Position

    if DetectionMode == "Camera" or DetectionMode == "Both" then
        local _, onScreen = Camera:WorldToScreenPoint(targetHead.Position)

        if onScreen then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
            rayParams.FilterDescendantsInstances = { Character, character }

            if not workspace:Raycast(cameraPosition, targetHead.Position - cameraPosition, rayParams) then
                return true
            end
        end
    end

    if DetectionMode == "Raycast" or DetectionMode == "Both" then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Blacklist
        rayParams.FilterDescendantsInstances = { Character, character }

        if not workspace:Raycast(localHead.Position, targetHead.Position - localHead.Position, rayParams) then
            return true
        end
    end

    return false
end

----------------------------------------------------------------
-- combat/targeting
----------------------------------------------------------------
-- Target selection shared by the aimbot, silent aim, triggerbot and
-- the auto-fire loops.
----------------------------------------------------------------

--- Every alive enemy in the server.
-- @return Player[]
getAllPlayers = function()
    local result = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isOnSameTeam(player) then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 then
                table.insert(result, player)
            end
        end
    end

    return result
end

--- Enemy whose head is closest to the cursor, inside SilentAimFOV.
-- @return Player|nil
getClosestPlayerToMouse = function()
    local bestPlayer = nil
    local bestDistance = SilentAimFOV

    local mousePosition = Vector2.new(Mouse.X, Mouse.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isOnSameTeam(player) then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local head = player.Character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local screenPoint, onScreen = Camera:WorldToScreenPoint(head.Position)

                if onScreen then
                    local distance = (mousePosition - Vector2.new(screenPoint.X, screenPoint.Y)).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        bestPlayer = player
                    end
                end
            end
        end
    end

    return bestPlayer
end

--- Enemy whose head is closest to the middle of the screen.
-- @return Player|nil
getClosestPlayerToCenter = function()
    local bestPlayer = nil
    local bestDistance = math.huge

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isOnSameTeam(player) then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local head = player.Character:FindFirstChild("Head")

            if humanoid and humanoid.Health > 0 and head then
                local screenPoint, onScreen = Camera:WorldToScreenPoint(head.Position)

                if onScreen then
                    local distance = (screenCenter - Vector2.new(screenPoint.X, screenPoint.Y)).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        bestPlayer = player
                    end
                end
            end
        end
    end

    return bestPlayer
end

--- Closest enemy within AutoStabRange of the local character.
-- @return Player|nil
getClosestPlayerInRange = function()
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local bestPlayer = nil
    local bestDistance = AutoStabRange
    local myRoot = Character.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isOnSameTeam(player) then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local root = player.Character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and root then
                local distance = (root.Position - myRoot.Position).Magnitude

                if distance < bestDistance then
                    bestDistance = distance
                    bestPlayer = player
                end
            end
        end
    end

    return bestPlayer
end

--- Shoots every enemy once, in player-list order.
killAll = function()
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character

        if player ~= LocalPlayer
            and character
            and character:IsDescendantOf(workspace)
            and not isOnSameTeam(player)
        then
            local humanoid = character:FindFirstChildOfClass("Humanoid")

            if humanoid and humanoid.Health > 0 and equipTool("Gun") then
                task.wait(0.1)
                shootGun(character)
            end
        end
    end
end

----------------------------------------------------------------
-- visual/esp
----------------------------------------------------------------
-- Drawing-based ESP.  Every tracked player owns a small pool of
-- Drawing objects: four box lines, fourteen skeleton lines, one
-- snapline and three text labels.
----------------------------------------------------------------

local R15_BONES = {
    { "Head", "UpperTorso" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" },
    { "LeftUpperArm", "LeftLowerArm" },
    { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" },
    { "RightUpperArm", "RightLowerArm" },
    { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" },
    { "LeftUpperLeg", "LeftLowerLeg" },
    { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" },
    { "RightUpperLeg", "RightLowerLeg" },
    { "RightLowerLeg", "RightFoot" },
}

local R6_BONES = {
    { "Head", "Torso" },
    { "Torso", "Left Arm" },
    { "Torso", "Right Arm" },
    { "Torso", "Left Leg" },
    { "Torso", "Right Leg" },
}

local MAX_SKELETON_LINES = 14

--- Current rainbow colour, or `fallback` when rainbow mode is off.
local function accentColour(fallback)
    if RainbowModeEnabled then
        return Color3.fromHSV(tick() % 5 / 5, 1, 1)
    end

    return fallback
end

--- Creates a hidden line drawing.
local function newLine(colour, thickness)
    local line = Drawing.new("Line")

    line.Thickness = thickness
    line.Color = colour
    line.Transparency = 1
    line.Visible = false

    return line
end

--- Creates a hidden, centred, outlined text drawing.
local function newText(text, size, colour)
    local label = Drawing.new("Text")

    label.Text = text
    label.Size = size
    label.Color = colour
    label.Transparency = 1
    label.Center = true
    label.Outline = true
    label.OutlineColor = Color3.new(0, 0, 0)
    label.Visible = false
    label.Font = 2

    return label
end

----------------------------------------------------------------
-- Pool management
----------------------------------------------------------------

--- Allocates the Drawing objects used for one player's ESP.
createESP = function(player)
    if not player.Character then
        return
    end

    if espCache[player] then
        removeESP(player)
    end

    local entry = {
        player = player,
        drawings = {},
    }

    for _ = 1, 4 do
        table.insert(entry.drawings, newLine(espBoxColor, 2))
    end

    for _ = 1, MAX_SKELETON_LINES do
        table.insert(entry.drawings, newLine(espSkeletonColor, 1))
    end

    entry.snapline = newLine(espSnaplineColor, 1)
    table.insert(entry.drawings, entry.snapline)

    entry.nameText = newText(player.Name, 16, espTextColor)
    table.insert(entry.drawings, entry.nameText)

    entry.healthText = newText("100 HP", 14, Color3.fromRGB(0, 255, 0))
    table.insert(entry.drawings, entry.healthText)

    entry.distanceText = newText("0m", 14, espTextColor)
    table.insert(entry.drawings, entry.distanceText)

    espCache[player] = entry
end

--- Removes and forgets one player's ESP drawings.
removeESP = function(player)
    local entry = espCache[player]
    if not entry then
        return
    end

    for _, drawing in ipairs(entry.drawings) do
        drawing:Remove()
    end

    espCache[player] = nil
end

----------------------------------------------------------------
-- Per-frame drawing
----------------------------------------------------------------

--- Hides every drawing in the inclusive index range.
local function hideRange(entry, first, last)
    for index = first, last do
        local drawing = entry.drawings[index]
        if drawing then
            drawing.Visible = false
        end
    end
end

--- Draws one bone pair at `index`, or hides the slot when it is off screen.
local function drawBone(entry, index, fromPart, toPart)
    local drawing = entry.drawings[index]
    if not drawing then
        return
    end

    local fromPoint = Camera:WorldToViewportPoint(fromPart.Position)
    local toPoint = Camera:WorldToViewportPoint(toPart.Position)

    if fromPoint.Z <= 0 or toPoint.Z <= 0 then
        drawing.Visible = false
        return
    end

    drawing.From = Vector2.new(fromPoint.X, fromPoint.Y)
    drawing.To = Vector2.new(toPoint.X, toPoint.Y)
    drawing.Visible = true
    drawing.Color = accentColour(espSkeletonColor)
end

--- Draws the skeleton for one entry, falling back to R6 names.
local function updateSkeleton(entry, character, firstSlot)
    local drawn = 0

    for index, bones in ipairs(R15_BONES) do
        if index > MAX_SKELETON_LINES then
            break
        end

        local fromPart = character:FindFirstChild(bones[1])
        local toPart = character:FindFirstChild(bones[2])

        if fromPart and toPart then
            drawBone(entry, firstSlot + drawn, fromPart, toPart)
            drawn = drawn + 1
        end
    end

    -- R15 lookup produced nothing: this is an R6 rig.
    if drawn == 0 then
        for index, bones in ipairs(R6_BONES) do
            if index > MAX_SKELETON_LINES then
                break
            end

            local fromPart = character:FindFirstChild(bones[1])
            local toPart = character:FindFirstChild(bones[2])

            if fromPart and toPart then
                drawBone(entry, firstSlot + drawn, fromPart, toPart)
                drawn = drawn + 1
            end
        end
    end

    hideRange(entry, firstSlot + drawn, firstSlot + MAX_SKELETON_LINES - 1)
end

--- Draws the 2D box around a character.
local function updateBox(entry, head, root)
    if not ESPShowBoxes then
        hideRange(entry, 1, 4)
        return
    end

    local top = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
    local bottom = root.Position - Vector3.new(0, 3, 0)

    local topScreen, topOnScreen = Camera:WorldToViewportPoint(top)
    local bottomScreen, bottomOnScreen = Camera:WorldToViewportPoint(bottom)

    if not topOnScreen and not bottomOnScreen then
        hideRange(entry, 1, 4)
        return
    end

    local halfWidth = math.abs(topScreen.Y - bottomScreen.Y) / 2

    local corners = {
        Vector2.new(topScreen.X - halfWidth / 2, topScreen.Y),
        Vector2.new(topScreen.X + halfWidth / 2, topScreen.Y),
        Vector2.new(bottomScreen.X + halfWidth / 2, bottomScreen.Y),
        Vector2.new(bottomScreen.X - halfWidth / 2, bottomScreen.Y),
    }

    for index = 1, 4 do
        local line = entry.drawings[index]

        line.From = corners[index]
        line.To = corners[index % 4 + 1]
        line.Visible = true
        line.Color = accentColour(espBoxColor)
    end
end

--- Draws the name / health / distance labels above the head.
local function updateLabels(entry, head, humanoid, distance)
    local anchor = head.Position + Vector3.new(0, head.Size.Y / 2 + 0.5, 0)
    local labelPosition, labelOnScreen = Camera:WorldToViewportPoint(anchor)

    if not labelOnScreen then
        entry.nameText.Visible = false
        entry.healthText.Visible = false
        entry.distanceText.Visible = false
        return
    end

    local offset = 0

    if ESPShowName then
        entry.nameText.Position = Vector2.new(labelPosition.X, labelPosition.Y + offset)
        entry.nameText.Visible = true
        entry.nameText.Color = accentColour(espTextColor)
        offset = offset + 18
    else
        entry.nameText.Visible = false
    end

    if ESPShowHealth then
        local health = math.floor(humanoid.Health)
        local maxHealth = math.floor(humanoid.MaxHealth)
        local ratio = health / maxHealth

        entry.healthText.Text = health .. " HP"

        if ratio > 0.6 then
            entry.healthText.Color = Color3.fromRGB(0, 255, 0)
        elseif ratio > 0.3 then
            entry.healthText.Color = Color3.fromRGB(255, 255, 0)
        else
            entry.healthText.Color = Color3.fromRGB(255, 0, 0)
        end

        entry.healthText.Position = Vector2.new(labelPosition.X, labelPosition.Y + offset)
        entry.healthText.Visible = true
        offset = offset + 16
    else
        entry.healthText.Visible = false
    end

    if ESPShowDistance then
        entry.distanceText.Text = math.floor(distance) .. "m"
        entry.distanceText.Position = Vector2.new(labelPosition.X, labelPosition.Y + offset)
        entry.distanceText.Visible = true
        entry.distanceText.Color = accentColour(espTextColor)
    else
        entry.distanceText.Visible = false
    end
end

--- Draws the line from the bottom of the screen to a player's feet.
local function updateSnapline(entry, root)
    if not ESPShowSnaplines then
        entry.snapline.Visible = false
        return
    end

    local rootPosition, rootOnScreen = Camera:WorldToViewportPoint(root.Position)

    if not rootOnScreen or rootPosition.Z <= 0 then
        entry.snapline.Visible = false
        return
    end

    entry.snapline.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    entry.snapline.To = Vector2.new(rootPosition.X, rootPosition.Y)
    entry.snapline.Visible = true
    entry.snapline.Color = accentColour(espSnaplineColor)
end

--- Refreshes one cached entry.
local function refreshEntry(player, entry)
    local character = player and player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not root then
        removeESP(player)
        return
    end

    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not head or not humanoid or humanoid.Health <= 0 then
        for _, drawing in ipairs(entry.drawings) do
            drawing.Visible = false
        end

        return
    end

    local distance = 0
    if Character and Character:FindFirstChild("HumanoidRootPart") then
        distance = (root.Position - Character.HumanoidRootPart.Position).Magnitude
    end

    updateBox(entry, head, root)

    if ESPShowSkeleton then
        -- With boxes on, the box lines are slots 1-4 and the skeleton
        -- starts at 5.  With boxes off the skeleton reuses slots 1-14.
        updateSkeleton(entry, character, ESPShowBoxes and 5 or 1)
    else
        hideRange(entry, 5, 5 + MAX_SKELETON_LINES - 1)
    end

    updateLabels(entry, head, humanoid, distance)
    updateSnapline(entry, root)
end

--- Refreshes every cached entry: boxes, skeleton, labels and snaplines.
updateESP = function()
    if not ESPEnabled then
        for player in pairs(espCache) do
            removeESP(player)
        end

        return
    end

    -- Drop entries whose player left or died for good.
    for player in pairs(espCache) do
        if not player or not player.Character or not player.Character:IsDescendantOf(workspace) then
            removeESP(player)
        end
    end

    -- Pick up newly visible players, drop players that became teammates.
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character

        if player ~= LocalPlayer and character and character:IsDescendantOf(workspace) then
            local hidden = ESPTeamCheckEnabled and isOnSameTeam(player)

            if hidden then
                if espCache[player] then
                    removeESP(player)
                end
            elseif not espCache[player] then
                createESP(player)
            end
        end
    end

    for player, entry in pairs(espCache) do
        refreshEntry(player, entry)
    end
end

